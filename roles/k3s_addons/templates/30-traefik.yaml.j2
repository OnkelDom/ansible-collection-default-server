---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: traefik
  namespace: kube-system
spec:
  repo: https://traefik.github.io/charts
  chart: traefik
{% if k3s_addons_traefik_chart_version | length > 0 %}
  version: "{{ k3s_addons_traefik_chart_version }}"
{% endif %}
  targetNamespace: traefik
  createNamespace: true
  valuesContent: |-
    deployment:
      kind: DaemonSet
      dnsPolicy: ClusterFirstWithHostNet
    updateStrategy:
      rollingUpdate:
        maxSurge: 0
        maxUnavailable: 1
    hostNetwork: true
    securityContext:
      allowPrivilegeEscalation: false
      capabilities:
        drop:
          - ALL
        add:
          - NET_BIND_SERVICE
      readOnlyRootFilesystem: true
    podSecurityContext:
      runAsNonRoot: false
      runAsUser: 0
      runAsGroup: 0
      seccompProfile:
        type: RuntimeDefault
    nodeSelector:
{% for key, value in k3s_addons_traefik_node_selector.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    tolerations:
      - key: "node-role.kubernetes.io/control-plane"
        operator: "Exists"
        effect: "NoSchedule"
    service:
      enabled: false
    ingressClass:
      enabled: true
      isDefaultClass: true
      name: "{{ k3s_addons_traefik_ingress_class }}"
    ports:
      traefik:
        port: 9000
      web:
        port: 80
        hostPort: 80
      websecure:
        port: 443
        hostPort: 443
        http:
          tls:
            enabled: true
{% if k3s_addons_traefik_git_ssh_enabled | bool %}
      gitssh:
        port: {{ k3s_addons_traefik_git_ssh_port | int }}
        hostPort: {{ k3s_addons_traefik_git_ssh_port | int }}
        expose:
          default: false
        exposedPort: {{ k3s_addons_traefik_git_ssh_port | int }}
        protocol: TCP
{% endif %}
    providers:
      kubernetesCRD:
        enabled: true
      kubernetesIngress:
        enabled: true
        publishedService:
          enabled: false
    log:
      level: INFO
