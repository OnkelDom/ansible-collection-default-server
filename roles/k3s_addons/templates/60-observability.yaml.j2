apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: kube-prometheus-stack
  namespace: kube-system
spec:
  repo: https://prometheus-community.github.io/helm-charts
  chart: kube-prometheus-stack
{% if k3s_addons_observability_chart_version | length > 0 %}
  version: "{{ k3s_addons_observability_chart_version }}"
{% endif %}
  targetNamespace: monitoring
  createNamespace: true
  valuesContent: |-
    fullnameOverride: kps
    crds:
      enabled: true
    defaultRules:
      create: true
    kubeControllerManager:
      enabled: false
    kubeEtcd:
      enabled: false
    kubeProxy:
      enabled: false
    kubeScheduler:
      enabled: false
    prometheus-node-exporter:
      service:
        port: 9101
        targetPort: 9101
        portName: metrics
    grafana:
      enabled: true
      adminPassword: "{{ k3s_addons_grafana_admin_password | trim }}"
{% if k3s_addons_grafana_oidc_enabled | bool %}
      envValueFrom:
        GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
          secretKeyRef:
            name: grafana-oidc
            key: client-secret
{% endif %}
      defaultDashboardsEnabled: true
      defaultDashboardsTimezone: browser
      persistence:
        enabled: true
        storageClassName: ceph-rbd
        size: "{{ k3s_addons_grafana_storage_size }}"
      deploymentStrategy:
        type: Recreate
      sidecar:
        dashboards:
          enabled: true
          label: grafana_dashboard
          searchNamespace: ALL
          provider:
            foldersFromFilesStructure: true
      additionalDataSources:
        - name: Loki
          type: loki
          access: proxy
          url: http://loki.monitoring.svc.cluster.local:3100
          isDefault: false
        - name: Tempo
          type: tempo
          access: proxy
          url: http://tempo.monitoring.svc.cluster.local:3200
          isDefault: false
          jsonData:
            tracesToLogsV2:
              datasourceUid: Loki
              tags:
                - service.name
                - service.namespace
      grafana.ini:
        server:
          root_url: "https://{{ k3s_addons_grafana_domain }}"
{% if k3s_addons_grafana_oidc_enabled | bool %}
        auth:
          signout_redirect_url: "{{ k3s_addons_grafana_oidc_signout_redirect_url }}"
          oauth_auto_login: {{ k3s_addons_grafana_oidc_auto_login | bool | lower }}
        auth.generic_oauth:
          enabled: true
          name: "{{ k3s_addons_grafana_oidc_name }}"
          allow_sign_up: {{ k3s_addons_grafana_oidc_allow_sign_up | bool | lower }}
          client_id: "{{ k3s_addons_grafana_oidc_client_id }}"
          client_secret: "$__env{GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET}"
          scopes: "{{ k3s_addons_grafana_oidc_scopes }}"
          auth_url: "{{ k3s_addons_grafana_oidc_auth_url }}"
          token_url: "{{ k3s_addons_grafana_oidc_token_url }}"
          api_url: "{{ k3s_addons_grafana_oidc_api_url }}"
          allowed_groups: "{{ k3s_addons_grafana_oidc_allowed_groups | join(' ') }}"
          groups_attribute_path: groups
          role_attribute_path: "contains(groups[*], '{{ k3s_addons_grafana_oidc_admin_group }}') && 'GrafanaAdmin' || contains(groups[*], '{{ k3s_addons_grafana_oidc_editor_group }}') && 'Editor' || 'Viewer'"
          role_attribute_strict: true
          allow_assign_grafana_admin: {{ k3s_addons_grafana_oidc_allow_assign_grafana_admin | bool | lower }}
{% endif %}
        plugins:
          preinstall_disabled: true
        users:
          default_theme: dark
      ingress:
        enabled: true
        ingressClassName: "{{ k3s_addons_traefik_ingress_class }}"
        annotations:
          cert-manager.io/cluster-issuer: letsencrypt-hetzner
        hosts:
          - "{{ k3s_addons_grafana_domain }}"
        tls:
          - secretName: k3s-grafana-tls
            hosts:
              - "{{ k3s_addons_grafana_domain }}"
    prometheus:
      prometheusSpec:
        serviceDiscoveryRole: EndpointSlice
        retention: "{{ k3s_addons_prometheus_retention }}"
        retentionSize: "{{ k3s_addons_prometheus_retention_size }}"
        storageSpec:
          volumeClaimTemplate:
            spec:
              storageClassName: ceph-rbd
              accessModes:
                - ReadWriteOnce
              resources:
                requests:
                  storage: "{{ k3s_addons_prometheus_storage_size }}"
    alertmanager:
{% if k3s_addons_alertmanager_email_enabled | bool %}
      config:
        global:
          smtp_smarthost: "{{ k3s_addons_alertmanager_smtp_smarthost }}"
          smtp_from: "{{ k3s_addons_alertmanager_email_from }}"
          smtp_require_tls: {{ k3s_addons_alertmanager_smtp_require_tls | bool | lower }}
        route:
          receiver: "null"
          group_by:
            - alertname
            - namespace
            - severity
          group_wait: 2m
          group_interval: 30m
          repeat_interval: 12h
          routes:
            - receiver: "null"
              matchers:
                - alertname="Watchdog"
              continue: false
            - receiver: "null"
              matchers:
                - alertname="InfoInhibitor"
              continue: false
            - receiver: default-mail
              matchers:
                - severity="critical"
              group_wait: 2m
              group_interval: 30m
              repeat_interval: 6h
        inhibit_rules:
          - source_matchers:
              - severity="critical"
            target_matchers:
              - severity=~"warning|info"
            equal:
              - namespace
              - alertname
          - source_matchers:
              - severity="warning"
            target_matchers:
              - severity="info"
            equal:
              - namespace
              - alertname
          - source_matchers:
              - alertname="InfoInhibitor"
            target_matchers:
              - severity="info"
            equal:
              - namespace
          - target_matchers:
              - alertname="InfoInhibitor"
        receivers:
          - name: "null"
          - name: default-mail
            email_configs:
              - to: "{{ k3s_addons_alertmanager_email_to }}"
                send_resolved: true
{% endif %}
      alertmanagerSpec:
        storage:
          volumeClaimTemplate:
            spec:
              storageClassName: ceph-rbd
              accessModes:
                - ReadWriteOnce
              resources:
                requests:
                  storage: "{{ k3s_addons_alertmanager_storage_size }}"
{% endif %}
