---
apiVersion: v1
kind: Secret
metadata:
  name: {{ k3s_addons_cephfs_secret_name | default('csi-cephfs-secret') }}
  namespace: ceph-csi
type: Opaque
data:
  userID: "{{ k3s_addons_ceph_user | b64encode }}"
  userKey: "{{ k3s_addons_ceph_user_key | b64encode }}"
  adminID: "{{ k3s_addons_ceph_user | b64encode }}"
  adminKey: "{{ k3s_addons_ceph_user_key | b64encode }}"
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: ceph-csi-cephfs
  namespace: kube-system
spec:
  repo: https://ceph.github.io/csi-charts
  chart: ceph-csi-cephfs
{% if k3s_addons_ceph_csi_chart_version | length > 0 %}
  version: "{{ k3s_addons_ceph_csi_chart_version }}"
{% endif %}
  targetNamespace: ceph-csi
  createNamespace: true
  valuesContent: |-
    csiConfig:
      - clusterID: "{{ k3s_addons_ceph_cluster_id }}"
        monitors:
{% for monitor in k3s_addons_ceph_monitors %}
          - "{{ monitor }}"
{% endfor %}
{% for cluster in k3s_addons_ceph_extra_clusters | default([]) %}
      - clusterID: "{{ cluster.clusterID }}"
        monitors:
{% for monitor in cluster.monitors %}
          - "{{ monitor }}"
{% endfor %}
{% endfor %}
    configMapName: ceph-csi-cephfs-config
    cephConfConfigMapName: ceph-csi-cephfs-ceph-conf
    kmsConfigMapName: ceph-csi-cephfs-encryption-kms-config
    provisioner:
      enableHostNetwork: {{ k3s_addons_ceph_provisioner_host_network | default(false) | bool | lower }}
{% if k3s_addons_ceph_provisioner_host_network | default(false) | bool %}
      httpMetrics:
        containerPort: 9081
{% endif %}
    secret:
      create: false
      name: {{ k3s_addons_cephfs_secret_name | default('csi-cephfs-secret') }}
    storageClass:
      create: true
      name: cephfs
      annotations: {}
      clusterID: "{{ k3s_addons_ceph_cluster_id }}"
      fsName: "{{ k3s_addons_cephfs_name }}"
      pool: "{{ k3s_addons_cephfs_pool }}"
      provisionerSecret: {{ k3s_addons_cephfs_secret_name | default('csi-cephfs-secret') }}
      provisionerSecretNamespace: ceph-csi
      controllerExpandSecret: {{ k3s_addons_cephfs_secret_name | default('csi-cephfs-secret') }}
      controllerExpandSecretNamespace: ceph-csi
      controllerPublishSecret: {{ k3s_addons_cephfs_secret_name | default('csi-cephfs-secret') }}
      controllerPublishSecretNamespace: ceph-csi
      nodeStageSecret: {{ k3s_addons_cephfs_secret_name | default('csi-cephfs-secret') }}
      nodeStageSecretNamespace: ceph-csi
      reclaimPolicy: Delete
      allowVolumeExpansion: true
    volumeSnapshotClass:
      create: {{ k3s_addons_snapshot_controller_enabled | default(true) | bool | lower }}
      name: {{ k3s_addons_cephfs_snapshot_class | default('cephfs-snapclass') }}
      labels:
        velero.io/csi-volumesnapshot-class: "true"
      clusterID: "{{ k3s_addons_ceph_cluster_id }}"
      snapshotterSecret: {{ k3s_addons_cephfs_secret_name | default('csi-cephfs-secret') }}
      snapshotterSecretNamespace: ceph-csi
      deletionPolicy: Retain
