{% if k3s_platform_apps_bulwark_enabled | bool %}
---
apiVersion: v1
kind: Secret
metadata:
  name: bulwark-runtime
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: bulwark
    app.kubernetes.io/part-of: platform-bus
type: Opaque
stringData:
  SESSION_SECRET: {{ k3s_platform_apps_bulwark_session_secret | to_json }}
  ADMIN_PASSWORD: {{ k3s_platform_apps_bulwark_admin_password | to_json }}
  OAUTH_CLIENT_SECRET: {{ k3s_platform_apps_bulwark_oidc_client_secret | to_json }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: bulwark-data
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: bulwark
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_bulwark_storage_size }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bulwark
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: bulwark
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_bulwark_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: bulwark
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bulwark
        app.kubernetes.io/part-of: platform-bus
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1001
        runAsGroup: 1001
        fsGroup: 1001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: bulwark
          image: "{{ k3s_platform_apps_bulwark_image }}"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          env:
            - {name: APP_NAME, value: "LenMail Webmail"}
            - {name: APP_SHORT_NAME, value: "LenMail"}
            - {name: JMAP_SERVER_URL, value: "https://{{ k3s_platform_apps_mail_domain }}"}
            - {name: STALWART_FEATURES, value: "true"}
            - {name: OAUTH_ENABLED, value: "true"}
            - {name: OAUTH_ONLY, value: "true"}
            - {name: OAUTH_CLIENT_ID, value: "{{ k3s_platform_apps_bulwark_oidc_client_id }}"}
            - name: OAUTH_CLIENT_SECRET
              valueFrom: {secretKeyRef: {name: bulwark-runtime, key: OAUTH_CLIENT_SECRET}}
            - {name: OAUTH_ISSUER_URL, value: "https://{{ k3s_platform_apps_authentik_domain }}/application/o/webmail/"}
            - {name: OAUTH_ALLOW_PRIVATE_ENDPOINTS, value: "true"}
            - {name: OAUTH_SCOPES, value: "openid email profile offline_access"}
            - {name: AUTO_SSO_ENABLED, value: "true"}
            - name: SESSION_SECRET
              valueFrom: {secretKeyRef: {name: bulwark-runtime, key: SESSION_SECRET}}
            - {name: SETTINGS_SYNC_ENABLED, value: "true"}
            - {name: SETTINGS_DATA_DIR, value: "/app/data/settings"}
            - {name: ADMIN_CONFIG_DIR, value: "/app/data/admin"}
            - {name: ADMIN_STATE_DIR, value: "/app/data/admin-state"}
            - name: ADMIN_PASSWORD
              valueFrom: {secretKeyRef: {name: bulwark-runtime, key: ADMIN_PASSWORD}}
            - {name: BULWARK_TELEMETRY, value: "off"}
            - {name: TELEMETRY_DATA_DIR, value: "/app/data/telemetry"}
            - {name: TRUSTED_PROXY_DEPTH, value: "1"}
            - {name: LOG_FORMAT, value: "json"}
            - {name: LOG_LEVEL, value: "info"}
            - {name: SEARCH_ENGINE_INDEXING, value: "false"}
          ports:
            - {name: http, containerPort: 3000}
          readinessProbe:
            httpGet: {path: /api/health, port: http}
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet: {path: /api/health, port: http}
            initialDelaySeconds: 30
            periodSeconds: 30
          resources:
            requests: {cpu: "{{ k3s_platform_apps_bulwark_requests_cpu }}", memory: "{{ k3s_platform_apps_bulwark_requests_memory }}"}
            limits: {cpu: "{{ k3s_platform_apps_bulwark_limits_cpu }}", memory: "{{ k3s_platform_apps_bulwark_limits_memory }}"}
          volumeMounts:
            - {name: data, mountPath: /app/data}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: bulwark-data}
---
apiVersion: v1
kind: Service
metadata:
  name: bulwark
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: bulwark
    app.kubernetes.io/part-of: platform-bus
spec:
  selector: {app.kubernetes.io/name: bulwark}
  ports:
    - {name: http, port: 3000, targetPort: http}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: bulwark
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: bulwark
    app.kubernetes.io/part-of: platform-bus
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: bulwark-tls
      hosts: ["{{ k3s_platform_apps_webmail_domain }}"]
  rules:
    - host: "{{ k3s_platform_apps_webmail_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: {name: bulwark, port: {name: http}}
{% endif %}
