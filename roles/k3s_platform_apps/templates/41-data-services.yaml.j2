{% if k3s_platform_apps_data_services_enabled | bool and k3s_platform_apps_postgres_enabled | bool %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-init
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/part-of: platform-bus
data:
  10-platform-bus-init.sh: |
    #!/usr/bin/env bash
    set -euo pipefail

    create_db_and_user() {
      local db="$1"
      local user="$2"
      local pass="$3"

      psql -v ON_ERROR_STOP=1 \
        -v app_db="$db" \
        -v app_user="$user" \
        -v app_pass="$pass" \
        --username "$POSTGRES_USER" \
        --dbname "$POSTGRES_DB" <<-'SQL'
        SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'app_user', :'app_pass')
        WHERE NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = :'app_user')\gexec
        SELECT format('CREATE DATABASE %I OWNER %I', :'app_db', :'app_user')
        WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'app_db')\gexec
        SELECT format('GRANT ALL PRIVILEGES ON DATABASE %I TO %I', :'app_db', :'app_user')\gexec
    SQL
    }

    grant_database_create() {
      local db="$1"
      local user="$2"

      psql -v ON_ERROR_STOP=1 \
        -v app_db="$db" \
        -v app_user="$user" \
        --username "$POSTGRES_USER" \
        --dbname "$POSTGRES_DB" <<-'SQL'
        SELECT format('GRANT CREATE ON DATABASE %I TO %I', :'app_db', :'app_user')\gexec
    SQL
    }

    create_from_prefix() {
      local prefix="$1"
      local db_var="${prefix}_DB"
      local user_var="${prefix}_DB_USER"
      local pass_var="${prefix}_DB_PASS"

      if [[ -n "${!db_var:-}" && -n "${!user_var:-}" && -n "${!pass_var:-}" ]]; then
        create_db_and_user "${!db_var}" "${!user_var}" "${!pass_var}"
      fi
    }

    create_from_prefix AUTHENTIK
    create_from_prefix GITEA
    create_from_prefix SEMAPHORE
    create_from_prefix OUTLINE
    create_from_prefix NETBOX
    create_from_prefix GRAFANA
    create_from_prefix PDNS
    create_from_prefix PDNS_ADMIN
    create_from_prefix N8N

    if [[ -n "${NETBOX_DB:-}" && -n "${NETBOX_DB_USER:-}" ]]; then
      grant_database_create "$NETBOX_DB" "$NETBOX_DB_USER"
    fi
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/part-of: platform-bus
spec:
  serviceName: postgres
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: postgres
        app.kubernetes.io/part-of: platform-bus
    spec:
      securityContext:
        fsGroup: 999
      containers:
        - name: postgres
          image: "{{ k3s_platform_apps_postgres_image }}"
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef:
                name: "{{ k3s_platform_apps_runtime_secret_name }}"
          env:
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: POSTGRES_SUPERUSER
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: POSTGRES_SUPERPASS
          ports:
            - name: postgres
              containerPort: 5432
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -ec
                - pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
            initialDelaySeconds: 10
            periodSeconds: 15
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - -ec
                - pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
            initialDelaySeconds: 60
            periodSeconds: 30
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
            - name: init
              mountPath: /docker-entrypoint-initdb.d/10-platform-bus-init.sh
              subPath: 10-platform-bus-init.sh
              readOnly: true
      volumes:
        - name: init
          configMap:
            name: postgres-init
            defaultMode: 0555
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes:
          - ReadWriteOnce
        storageClassName: ceph-rbd
        resources:
          requests:
            storage: "{{ k3s_platform_apps_postgres_storage_size }}"
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: postgres
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres
{% endif %}
{% if k3s_platform_apps_data_services_enabled | bool and k3s_platform_apps_redis_enabled | bool %}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: redis
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: redis
    app.kubernetes.io/part-of: platform-bus
spec:
  serviceName: redis
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: redis
  template:
    metadata:
      labels:
        app.kubernetes.io/name: redis
        app.kubernetes.io/part-of: platform-bus
    spec:
      securityContext:
        fsGroup: 999
      containers:
        - name: redis
          image: "{{ k3s_platform_apps_redis_image }}"
          imagePullPolicy: IfNotPresent
          command:
            - redis-server
            - --appendonly
            - "yes"
          ports:
            - name: redis
              containerPort: 6379
          readinessProbe:
            exec:
              command:
                - redis-cli
                - ping
            initialDelaySeconds: 5
            periodSeconds: 15
          livenessProbe:
            exec:
              command:
                - redis-cli
                - ping
            initialDelaySeconds: 30
            periodSeconds: 30
          volumeMounts:
            - name: data
              mountPath: /data
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes:
          - ReadWriteOnce
        storageClassName: ceph-rbd
        resources:
          requests:
            storage: "{{ k3s_platform_apps_redis_storage_size }}"
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: redis
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: redis
  ports:
    - name: redis
      port: 6379
      targetPort: redis
{% endif %}
