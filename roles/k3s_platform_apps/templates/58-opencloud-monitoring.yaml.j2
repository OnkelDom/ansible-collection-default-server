{% if k3s_platform_apps_opencloud_enabled | bool %}
---
apiVersion: v1
kind: Service
metadata:
  name: opencloud-node-exporter-external
  namespace: monitoring
  labels:
    app.kubernetes.io/name: opencloud-node-exporter
spec:
  ports:
    - name: metrics
      port: {{ k3s_platform_apps_opencloud_node_exporter_port }}
      targetPort: {{ k3s_platform_apps_opencloud_node_exporter_port }}
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: opencloud-node-exporter-external
  namespace: monitoring
  labels:
    kubernetes.io/service-name: opencloud-node-exporter-external
addressType: IPv4
ports:
  - name: metrics
    protocol: TCP
    port: {{ k3s_platform_apps_opencloud_node_exporter_port }}
endpoints:
  - addresses: ["{{ k3s_platform_apps_opencloud_address }}"]
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: opencloud-node-exporter
  namespace: monitoring
  labels:
    release: kube-prometheus-stack
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: opencloud-node-exporter
  namespaceSelector:
    matchNames: [monitoring]
  endpoints:
    - port: metrics
      interval: 30s
      relabelings:
        - targetLabel: instance
          replacement: cloud01.lenmail.de
        - targetLabel: platform
          replacement: platform-bus
---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: opencloud-vm
  namespace: monitoring
  labels:
    release: kube-prometheus-stack
spec:
  groups:
    - name: opencloud-vm.rules
      rules:
        - alert: OpenCloudVMExporterDown
          expr: up{service="opencloud-node-exporter-external"} == 0
          for: 5m
          labels: {severity: critical, service: opencloud}
          annotations:
            summary: OpenCloud VM metrics are unavailable
            description: Node Exporter on cloud01.lenmail.de has been unreachable for five minutes.
        - alert: OpenCloudCephFSMountMissing
          expr: opencloud_cephfs_mount_ok == 0
          for: 2m
          labels: {severity: critical, service: opencloud}
          annotations:
            summary: OpenCloud CephFS mount is missing
            description: /srv/opencloud is not backed by CephFS. Application writes must remain stopped.
        - alert: OpenCloudContainerDown
          expr: opencloud_container_running == 0
          for: 5m
          labels: {severity: critical, service: opencloud}
          annotations:
            summary: OpenCloud application container is down
            description: Expected container {{ "{{" }} $labels.service {{ "}}" }} is not running on cloud01.
{% endif %}
