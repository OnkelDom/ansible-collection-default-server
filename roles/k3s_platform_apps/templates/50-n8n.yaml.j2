{% if k3s_platform_apps_n8n_enabled | bool %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: n8n-data
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: n8n
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_n8n_storage_size }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: n8n
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_n8n_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: n8n
  template:
    metadata:
      labels:
        app.kubernetes.io/name: n8n
        app.kubernetes.io/part-of: platform-bus
    spec:
      securityContext:
        fsGroup: 1000
      containers:
        - name: n8n
          image: "{{ k3s_platform_apps_n8n_image }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: TZ
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: TZ
            - name: GENERIC_TIMEZONE
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: TZ
            - name: N8N_HOST
              value: "{{ k3s_platform_apps_n8n_domain }}"
            - name: N8N_PORT
              value: "5678"
            - name: N8N_PROTOCOL
              value: https
            - name: WEBHOOK_URL
              value: "https://{{ k3s_platform_apps_n8n_domain }}/"
            - name: N8N_EDITOR_BASE_URL
              value: "https://{{ k3s_platform_apps_n8n_domain }}"
            - name: N8N_SECURE_COOKIE
              value: "true"
            - name: N8N_METRICS
              value: "true"
            - name: N8N_USER_FOLDER
              value: /home/node/.n8n
            - name: N8N_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: N8N_ENCRYPTION_KEY
            - name: SEMAPHORE_API_BASE_URL
              value: "http://semaphore.{{ k3s_platform_apps_namespace }}.svc.cluster.local:3000"
            - name: SEMAPHORE_API_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_API_TOKEN
            - name: DB_TYPE
              value: postgresdb
            - name: DB_POSTGRESDB_HOST
              value: "{{ k3s_platform_apps_postgres_host }}"
            - name: DB_POSTGRESDB_PORT
              value: "5432"
            - name: DB_POSTGRESDB_DATABASE
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: N8N_DB
            - name: DB_POSTGRESDB_USER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: N8N_DB_USER
            - name: DB_POSTGRESDB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: N8N_DB_PASS
          ports:
            - name: http
              containerPort: 5678
          readinessProbe:
            httpGet:
              path: /healthz/readiness
              port: http
            initialDelaySeconds: 30
            periodSeconds: 15
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 90
            periodSeconds: 30
          volumeMounts:
            - name: data
              mountPath: /home/node/.n8n
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: n8n-data
---
apiVersion: v1
kind: Service
metadata:
  name: n8n
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: n8n
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: n8n
  ports:
    - name: http
      port: 5678
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: n8n
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: n8n
    app.kubernetes.io/part-of: platform-bus
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: n8n-tls
      hosts:
        - "{{ k3s_platform_apps_n8n_domain }}"
  rules:
    - host: "{{ k3s_platform_apps_n8n_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: n8n
                port:
                  name: http
{% endif %}
