{% if k3s_platform_apps_authentik_enabled | bool %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: authentik-media
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: authentik
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_authentik_media_storage_size }}"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: authentik-templates
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: authentik
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_authentik_templates_storage_size }}"
{% set authentik_env %}
            - name: AUTHENTIK_SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: AUTHENTIK_SECRET_KEY
            - name: AUTHENTIK_POSTGRESQL__HOST
              value: "{{ k3s_platform_apps_postgres_host }}"
            - name: AUTHENTIK_POSTGRESQL__PORT
              value: "5432"
            - name: AUTHENTIK_POSTGRESQL__NAME
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: AUTHENTIK_DB
            - name: AUTHENTIK_POSTGRESQL__USER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: AUTHENTIK_DB_USER
            - name: AUTHENTIK_POSTGRESQL__PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: AUTHENTIK_DB_PASS
            - name: AUTHENTIK_REDIS__HOST
              value: redis
            - name: AUTHENTIK_REDIS__PORT
              value: "6379"
            - name: AUTHENTIK_EMAIL__HOST
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_HOST
            - name: AUTHENTIK_EMAIL__PORT
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_PORT
            - name: AUTHENTIK_EMAIL__USERNAME
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_USERNAME
                  optional: true
            - name: AUTHENTIK_EMAIL__PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_PASSWORD
                  optional: true
            - name: AUTHENTIK_EMAIL__USE_TLS
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_TLS
                  optional: true
            - name: AUTHENTIK_EMAIL__FROM
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_FROM
            - name: AUTHENTIK_LISTEN__HTTP
              value: 0.0.0.0:9000
            - name: AUTHENTIK_LISTEN__METRICS
              value: 0.0.0.0:9300
            - name: AUTHENTIK_BOOTSTRAP_EMAIL
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: AUTHENTIK_BOOTSTRAP_EMAIL
            - name: AUTHENTIK_BOOTSTRAP_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: AUTHENTIK_BOOTSTRAP_PASSWORD
            - name: AUTHENTIK_BOOTSTRAP_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: AUTHENTIK_BOOTSTRAP_TOKEN
{% endset %}
{% set authentik_mounts %}
            - name: media
              mountPath: /media
            - name: templates
              mountPath: /templates
{% endset %}
{% set authentik_volumes %}
        - name: media
          persistentVolumeClaim:
            claimName: authentik-media
        - name: templates
          persistentVolumeClaim:
            claimName: authentik-templates
{% endset %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authentik-server
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: authentik-server
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_authentik_server_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: authentik-server
  template:
    metadata:
      labels:
        app.kubernetes.io/name: authentik-server
        app.kubernetes.io/part-of: platform-bus
    spec:
{% if k3s_platform_apps_authentik_node_selector | length > 0 %}
      nodeSelector:
{{ k3s_platform_apps_authentik_node_selector | to_nice_yaml(indent=2) | indent(8, true) }}
{% endif %}
      securityContext:
        fsGroup: 1000
      containers:
        - name: authentik-server
          image: "{{ k3s_platform_apps_authentik_image }}"
          imagePullPolicy: IfNotPresent
          args:
            - server
          env:
{{ authentik_env }}
          ports:
            - name: http
              containerPort: 9000
            - name: metrics
              containerPort: 9300
          readinessProbe:
            exec:
              command:
                - ak
                - healthcheck
            initialDelaySeconds: 120
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 10
          livenessProbe:
            exec:
              command:
                - ak
                - healthcheck
            initialDelaySeconds: 240
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 5
          volumeMounts:
{{ authentik_mounts }}
      volumes:
{{ authentik_volumes }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: authentik-worker
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: authentik-worker
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_authentik_worker_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: authentik-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: authentik-worker
        app.kubernetes.io/part-of: platform-bus
    spec:
{% if k3s_platform_apps_authentik_node_selector | length > 0 %}
      nodeSelector:
{{ k3s_platform_apps_authentik_node_selector | to_nice_yaml(indent=2) | indent(8, true) }}
{% endif %}
      securityContext:
        fsGroup: 1000
      containers:
        - name: authentik-worker
          image: "{{ k3s_platform_apps_authentik_image }}"
          imagePullPolicy: IfNotPresent
          args:
            - worker
          env:
{{ authentik_env }}
          ports:
            - name: metrics
              containerPort: 9300
          readinessProbe:
            exec:
              command:
                - ak
                - healthcheck
            initialDelaySeconds: 120
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 10
          livenessProbe:
            exec:
              command:
                - ak
                - healthcheck
            initialDelaySeconds: 240
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 5
          volumeMounts:
{{ authentik_mounts }}
      volumes:
{{ authentik_volumes }}
---
apiVersion: v1
kind: Service
metadata:
  name: authentik-server
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: authentik-server
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: authentik-server
  ports:
    - name: http
      port: 9000
      targetPort: http
    - name: metrics
      port: 9300
      targetPort: metrics
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: authentik
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: authentik
    app.kubernetes.io/part-of: platform-bus
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: authentik-tls
      hosts:
        - "{{ k3s_platform_apps_authentik_app_domain }}"
  rules:
    - host: "{{ k3s_platform_apps_authentik_app_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: authentik-server
                port:
                  name: http
{% endif %}
