---
apiVersion: v1
kind: Secret
metadata:
  name: "{{ k3s_platform_apps_runtime_secret_name }}"
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: platform-bus-runtime-env
    app.kubernetes.io/part-of: platform-bus
type: Opaque
stringData:
{% for key in k3s_platform_apps_runtime_env_keys %}
{% if key in k3s_platform_apps_runtime_env %}
  {{ key }}: {{ k3s_platform_apps_runtime_env[key] | to_json }}
{% endif %}
{% endfor %}
