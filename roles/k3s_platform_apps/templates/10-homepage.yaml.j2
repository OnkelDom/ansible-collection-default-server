{% if k3s_platform_apps_homepage_enabled | bool %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-config
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: homepage
    app.kubernetes.io/part-of: platform-bus
data:
  settings.yaml: |
    ---
    title: {{ k3s_platform_apps_homepage_title }}
    description: LenMail PlattformBUS k3s operations portal
    theme: dark
    color: slate
    language: de
    target: _blank
    hideVersion: true
    statusStyle: dot
    layout:
      Core:
        style: row
        columns: 4
      Operations:
        style: row
        columns: 4
      Observability:
        style: row
        columns: 4
      Runtime:
        style: row
        columns: 4
  widgets.yaml: |
    ---
    - resources:
        cpu: true
        memory: true
        disk: /
    - search:
        provider: custom
        url: https://www.google.com/search?q=
        target: _blank
  bookmarks.yaml: |
    ---
    - LenMail:
        - Dokumentation:
            - abbr: DOC
              href: https://docs.lenmail.de
        - Grafana:
            - abbr: G
              href: https://{{ k3s_platform_apps_blackbox_targets | selectattr('name', 'equalto', 'dash') | map(attribute='url') | first | default('dash.k3s.lenmail.de') | regex_replace('^https?://', '') }}
  docker.yaml: |
    ---
  services.yaml: |
    ---
    - Core:
        - Authentik:
            icon: authentik.svg
            href: https://auth.{{ k3s_platform_apps_cluster_domain }}
            description: Identity provider and SSO control plane
        - Git:
            icon: gitea.svg
            href: https://git.{{ k3s_platform_apps_cluster_domain }}
            description: Source repositories and runners
        - Wiki:
            icon: outline.svg
            href: https://wiki.{{ k3s_platform_apps_cluster_domain }}
            description: Platform documentation
        - CMDB:
            icon: netbox.svg
            href: https://cmdb.{{ k3s_platform_apps_cluster_domain }}
            description: Infrastructure source of truth
    - Operations:
        - n8n:
            icon: n8n.svg
            href: https://n8n.{{ k3s_platform_apps_cluster_domain }}
            description: Process automation and webhooks
        - Ops:
            icon: semaphore.svg
            href: https://ops.{{ k3s_platform_apps_cluster_domain }}
            description: Ansible automation
        - DBA:
            icon: postgres.svg
            href: https://dba.{{ k3s_platform_apps_cluster_domain }}
            description: PostgreSQL administration
        - DNS:
            icon: powerdns.svg
            href: https://dns.{{ k3s_platform_apps_cluster_domain }}
            description: Authoritative DNS management
        - Admin:
            icon: docker.svg
            href: https://admin.{{ k3s_platform_apps_cluster_domain }}
            description: Runtime administration
    - Observability:
        - Dash:
            icon: grafana.svg
            href: https://dash.{{ k3s_platform_apps_cluster_domain }}
            description: Dashboards and visual analysis
        - Mon:
            icon: prometheus.svg
            href: https://mon.{{ k3s_platform_apps_cluster_domain }}
            description: Metrics query engine
        - Alert:
            icon: alertmanager.svg
            href: https://alert.{{ k3s_platform_apps_cluster_domain }}
            description: Alert routing and silences
        - Logs:
            icon: loki.svg
            href: https://logs.{{ k3s_platform_apps_cluster_domain }}
            description: Log storage endpoint
        - Traces:
            icon: grafana-tempo.svg
            href: https://traces.{{ k3s_platform_apps_cluster_domain }}
            description: Trace storage endpoint
    - Runtime:
        - k3s API:
            icon: kubernetes.svg
            href: https://dash.{{ k3s_platform_apps_cluster_domain }}/d/platform-bus-k3s-ops/platform-bus-k3s-operations
            description: Cluster health, nodes and workloads
        - Ingress:
            icon: traefik.svg
            href: https://proxy.{{ k3s_platform_apps_cluster_domain }}
            description: Edge routing and certificates
        - Storage:
            icon: ceph.svg
            href: https://storage.{{ k3s_platform_apps_product_domain }}
            description: Ceph backed persistent volumes
        - Portal:
            icon: homepage.svg
            href: https://{{ k3s_platform_apps_homepage_domain }}
            description: k3s operations portal
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homepage
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: homepage
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_homepage_replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: homepage
  template:
    metadata:
      labels:
        app.kubernetes.io/name: homepage
        app.kubernetes.io/part-of: platform-bus
    spec:
      containers:
        - name: homepage
          image: "{{ k3s_platform_apps_homepage_image }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: TZ
              value: Europe/Berlin
            - name: HOMEPAGE_ALLOWED_HOSTS
              value: "{{ k3s_platform_apps_homepage_domain }}"
          ports:
            - name: http
              containerPort: 3000
          volumeMounts:
            - name: config-dir
              mountPath: /app/config
            - name: config
              mountPath: /app/config/settings.yaml
              subPath: settings.yaml
              readOnly: true
            - name: config
              mountPath: /app/config/services.yaml
              subPath: services.yaml
              readOnly: true
            - name: config
              mountPath: /app/config/widgets.yaml
              subPath: widgets.yaml
              readOnly: true
            - name: config
              mountPath: /app/config/bookmarks.yaml
              subPath: bookmarks.yaml
              readOnly: true
            - name: config
              mountPath: /app/config/docker.yaml
              subPath: docker.yaml
              readOnly: true
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 10
            periodSeconds: 15
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 30
            periodSeconds: 30
      volumes:
        - name: config-dir
          emptyDir: {}
        - name: config
          configMap:
            name: homepage-config
---
apiVersion: v1
kind: Service
metadata:
  name: homepage
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: homepage
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: homepage
  ports:
    - name: http
      port: 3000
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: homepage
  namespace: "{{ k3s_platform_apps_namespace }}"
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
{% if k3s_platform_apps_product_aliases_enabled | bool %}
    traefik.ingress.kubernetes.io/router.middlewares: "{{ k3s_platform_apps_namespace }}-portal-product-alias@kubernetescrd"
{% elif k3s_platform_apps_forwardauth_enabled | bool %}
    traefik.ingress.kubernetes.io/router.middlewares: "{{ k3s_platform_apps_namespace }}-authentik-forwardauth@kubernetescrd"
{% endif %}
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: homepage-tls
      hosts:
        - "{{ k3s_platform_apps_homepage_domain }}"
  rules:
    - host: "{{ k3s_platform_apps_homepage_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: homepage
                port:
                  name: http
{% endif %}
