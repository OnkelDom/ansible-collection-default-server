{% if k3s_platform_apps_matrix_enabled | bool and k3s_platform_apps_matrix_metrics_enabled | bool %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-matrix
  namespace: monitoring
  labels: {grafana_dashboard: "1", app.kubernetes.io/part-of: platform-bus}
data:
  matrix.json: |-
    {
      "editable":true,
      "panels":[
        {"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"mappings":[],"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}},"overrides":[]},"gridPos":{"h":5,"w":6,"x":0,"y":0},"id":1,"options":{"colorMode":"background","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"expr":"up{job=~\".*matrix-synapse.*\"}","refId":"A"}],"title":"Synapse metrics","type":"stat"},
        {"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"mappings":[],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]},"gridPos":{"h":5,"w":6,"x":6,"y":0},"id":2,"options":{"colorMode":"background","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"expr":"sum(increase(kube_pod_container_status_restarts_total{namespace=\"{{ k3s_platform_apps_namespace }}\",pod=~\"matrix-.*\"}[1h]))","refId":"A"}],"title":"Restarts (1h)","type":"stat"},
        {"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"mappings":[],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":80},{"color":"red","value":90}]},"unit":"percent"},"overrides":[]},"gridPos":{"h":5,"w":6,"x":12,"y":0},"id":3,"options":{"colorMode":"background","graphMode":"none","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"expr":"100 * kubelet_volume_stats_used_bytes{namespace=\"{{ k3s_platform_apps_namespace }}\",persistentvolumeclaim=~\"matrix-.*\"} / kubelet_volume_stats_capacity_bytes{namespace=\"{{ k3s_platform_apps_namespace }}\",persistentvolumeclaim=~\"matrix-.*\"}","legendFormat":"{% raw %}{{persistentvolumeclaim}}{% endraw %}","refId":"A"}],"title":"PVC usage","type":"stat"},
        {"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"mappings":[],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]}},"overrides":[]},"gridPos":{"h":5,"w":6,"x":18,"y":0},"id":4,"options":{"colorMode":"value","graphMode":"area","justifyMode":"center","orientation":"auto","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"auto"},"targets":[{"expr":"synapse_admin_daily_active_users","refId":"A"}],"title":"Daily active users","type":"stat"},
        {"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"drawStyle":"line","fillOpacity":15,"lineWidth":1,"showPoints":"never"},"mappings":[],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]},"unit":"bytes"},"overrides":[]},"gridPos":{"h":8,"w":12,"x":0,"y":5},"id":5,"options":{"legend":{"calcs":["lastNotNull"],"displayMode":"table","placement":"right","showLegend":true},"tooltip":{"mode":"multi","sort":"none"}},"targets":[{"expr":"process_resident_memory_bytes{job=~\".*matrix-synapse.*\"}","refId":"A"}],"title":"Synapse resident memory","type":"timeseries"},
        {"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"drawStyle":"line","fillOpacity":15,"lineWidth":1,"showPoints":"never"},"mappings":[],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]}},"overrides":[]},"gridPos":{"h":8,"w":12,"x":12,"y":5},"id":6,"options":{"legend":{"calcs":["lastNotNull"],"displayMode":"table","placement":"right","showLegend":true},"tooltip":{"mode":"multi","sort":"none"}},"targets":[{"expr":"rate(synapse_http_server_request_count_total[5m])","legendFormat":"{% raw %}{{method}} {{servlet}}{% endraw %}","refId":"A"}],"title":"HTTP request rate","type":"timeseries"}
      ],
      "refresh":"30s","schemaVersion":39,"tags":["platform-bus","matrix","synapse"],"templating":{"list":[]},"time":{"from":"now-6h","to":"now"},"timezone":"browser","title":"Plattform-BUS Matrix","uid":"platform-bus-matrix","version":1
    }
{% endif %}
