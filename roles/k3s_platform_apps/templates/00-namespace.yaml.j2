---
apiVersion: v1
kind: Namespace
metadata:
  name: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/part-of: platform-bus
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/audit-version: latest
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/warn-version: latest
---
apiVersion: v1
kind: Namespace
metadata:
  name: monitoring
  labels:
    app.kubernetes.io/part-of: platform-bus
{% if k3s_platform_apps_authentik_enabled | bool and k3s_platform_apps_forwardauth_enabled | bool %}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authentik-forwardauth
  namespace: "{{ k3s_platform_apps_namespace }}"
spec:
  forwardAuth:
    address: "{{ k3s_platform_apps_forwardauth_address }}"
    trustForwardHeader: true
    authResponseHeaders:
      - X-authentik-username
      - X-authentik-groups
      - X-authentik-email
      - X-authentik-name
      - X-authentik-uid
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authentik-forwardauth
  namespace: monitoring
spec:
  forwardAuth:
    address: "{{ k3s_platform_apps_forwardauth_address }}"
    trustForwardHeader: true
    authResponseHeaders:
      - X-authentik-username
      - X-authentik-groups
      - X-authentik-email
      - X-authentik-name
      - X-authentik-uid
{% if k3s_platform_apps_product_aliases_enabled | bool %}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: portal-product-alias
  namespace: "{{ k3s_platform_apps_namespace }}"
spec:
  redirectRegex:
    regex: '^https://{{ k3s_platform_apps_homepage_domain | regex_escape }}(.*)'
    replacement: 'https://portal.{{ k3s_platform_apps_product_domain }}${1}'
    permanent: true
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: n8n-product-alias
  namespace: "{{ k3s_platform_apps_namespace }}"
spec:
  redirectRegex:
    regex: '^https://{{ k3s_platform_apps_n8n_domain | regex_escape }}(.*)'
    replacement: 'https://n8n.{{ k3s_platform_apps_product_domain }}${1}'
    permanent: true
{% endif %}
{% endif %}
