{% if k3s_platform_apps_piler_enabled | bool %}
---
apiVersion: v1
kind: Secret
metadata:
  name: piler-runtime
  namespace: "{{ k3s_platform_apps_namespace }}"
type: Opaque
stringData:
  MYSQL_PASSWORD: {{ k3s_platform_apps_piler_database_password | to_json }}
  ADMIN_USER_PASSWORD_HASH: {{ k3s_platform_apps_piler_admin_password_hash | to_json }}
  LDAP_PASSWORD: {{ k3s_platform_apps_piler_ldap_password | to_json }}
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: ak-outpost-platform-ldap, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: ak-outpost-platform-ldap}}
  template:
    metadata: {labels: {app.kubernetes.io/name: ak-outpost-platform-ldap, app.kubernetes.io/part-of: platform-bus}}
    spec:
      containers:
        - name: ldap
          image: "{{ k3s_platform_apps_piler_ldap_outpost_image }}"
          env:
            - {name: AUTHENTIK_HOST, value: "http://authentik-server.platform-bus.svc.cluster.local:9000"}
            - {name: AUTHENTIK_INSECURE, value: "true"}
            - {name: AUTHENTIK_TOKEN, valueFrom: {secretKeyRef: {name: authentik-ldap-outpost, key: token}}}
          ports: [{name: ldap, containerPort: 3389}, {name: ldaps, containerPort: 6636}]
          readinessProbe: {tcpSocket: {port: ldap}, initialDelaySeconds: 10, periodSeconds: 10}
          resources: {requests: {cpu: 30m, memory: 96Mi}, limits: {cpu: 300m, memory: 256Mi}}
---
apiVersion: v1
kind: Service
metadata: {name: ak-outpost-platform-ldap, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  selector: {app.kubernetes.io/name: ak-outpost-platform-ldap}
  ports: [{name: ldap, port: 389, targetPort: ldap}, {name: ldaps, port: 636, targetPort: ldaps}]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: piler-manticore
  namespace: "{{ k3s_platform_apps_namespace }}"
data:
  manticore.conf: |
    index piler1 {
      type = rt
      path = /var/lib/manticore/piler1
      rt_mem_limit = 256M
      stored_fields =
      min_word_len = 1
      min_prefix_len = 5
      rt_field = sender
      rt_field = rcpt
      rt_field = senderdomain
      rt_field = rcptdomain
      rt_field = subject
      rt_field = body
      rt_field = attachment_types
      rt_attr_bigint = arrived
      rt_attr_bigint = sent
      rt_attr_uint = size
      rt_attr_uint = direction
      rt_attr_uint = folder
      rt_attr_uint = attachments
    }
    index tag1 {
      type = rt
      path = /var/lib/manticore/tag1
      rt_mem_limit = 16M
      stored_fields = tag
      min_word_len = 2
      min_prefix_len = 5
      rt_field = tag
      rt_attr_bigint = mid
      rt_attr_uint = uid
    }
    index note1 {
      type = rt
      path = /var/lib/manticore/note1
      rt_mem_limit = 16M
      stored_fields = note
      min_word_len = 2
      min_prefix_len = 5
      rt_field = note
      rt_attr_bigint = mid
      rt_attr_uint = uid
    }
    index audit1 {
      type = rt
      path = /var/lib/manticore/audit1
      rt_mem_limit = 16M
      stored_fields = *
      min_word_len = 2
      min_prefix_len = 5
      rt_field = email
      rt_field = ipaddr
      rt_field = description
      rt_attr_bigint = ts
      rt_attr_bigint = meta_id
      rt_attr_uint = action
    }
    searchd {
      listen = 0.0.0.0:9312
      listen = 0.0.0.0:9306:mysql
      listen = 0.0.0.0:9307:mysql_readonly
      log = /var/lib/manticore/manticore.log
      query_log = /var/lib/manticore/query.log
      binlog_path = /var/lib/manticore
      pid_file = /var/lib/manticore/manticore.pid
      network_timeout = 5
      seamless_rotate = 1
      preopen_tables = 1
      unlink_old = 1
      thread_stack = 512k
      buddy_path =
      rt_flush_period = 300
    }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: {name: piler-config, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: ceph-rbd
  resources: {requests: {storage: "{{ k3s_platform_apps_piler_config_size }}"}}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: {name: piler-store, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: ceph-rbd
  resources: {requests: {storage: "{{ k3s_platform_apps_piler_store_size }}"}}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: {name: piler-index, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: ceph-rbd
  resources: {requests: {storage: "{{ k3s_platform_apps_piler_index_size }}"}}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: {name: piler-database, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: ceph-rbd
  resources: {requests: {storage: "{{ k3s_platform_apps_piler_database_size }}"}}
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: piler-mariadb, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  serviceName: piler-mariadb
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: piler-mariadb}}
  template:
    metadata: {labels: {app.kubernetes.io/name: piler-mariadb, app.kubernetes.io/part-of: platform-bus}}
    spec:
      containers:
        - name: mariadb
          image: "{{ k3s_platform_apps_piler_mariadb_image }}"
          args: ["--character-set-server=utf8mb4", "--collation-server=utf8mb4_unicode_ci", "--innodb-buffer-pool-size=256M"]
          env:
            - {name: MARIADB_DATABASE, value: piler}
            - {name: MARIADB_USER, value: piler}
            - {name: MARIADB_PASSWORD, valueFrom: {secretKeyRef: {name: piler-runtime, key: MYSQL_PASSWORD}}}
            - {name: MARIADB_RANDOM_ROOT_PASSWORD, value: "yes"}
          ports: [{name: mysql, containerPort: 3306}]
          readinessProbe: {tcpSocket: {port: mysql}, initialDelaySeconds: 10, periodSeconds: 10}
          resources: {requests: {cpu: 100m, memory: 384Mi}, limits: {cpu: "1", memory: 768Mi}}
          volumeMounts: [{name: data, mountPath: /var/lib/mysql}]
      volumes: [{name: data, persistentVolumeClaim: {claimName: piler-database}}]
---
apiVersion: v1
kind: Service
metadata: {name: piler-mariadb, namespace: "{{ k3s_platform_apps_namespace }}"}
spec: {selector: {app.kubernetes.io/name: piler-mariadb}, ports: [{name: mysql, port: 3306}]}
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: piler-manticore, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  serviceName: piler-manticore
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: piler-manticore}}
  template:
    metadata: {labels: {app.kubernetes.io/name: piler-manticore, app.kubernetes.io/part-of: platform-bus}}
    spec:
      initContainers:
        - name: prepare-manticore
          image: "docker.io/library/busybox:1.37"
          command: [/bin/sh, -ec]
          args: ["cp /source/manticore.conf /config/manticore.conf && chown -R 999:999 /config /var/lib/manticore"]
          volumeMounts:
            - {name: data, mountPath: /var/lib/manticore}
            - {name: source, mountPath: /source, readOnly: true}
            - {name: config, mountPath: /config}
      containers:
        - name: manticore
          image: "{{ k3s_platform_apps_piler_manticore_image }}"
          command: [searchd]
          args: [--nodetach, --config, /etc/manticoresearch/manticore.conf]
          ports: [{name: mysql, containerPort: 9306}, {name: readonly, containerPort: 9307}, {name: native, containerPort: 9312}]
          readinessProbe: {tcpSocket: {port: mysql}, initialDelaySeconds: 10, periodSeconds: 10}
          resources: {requests: {cpu: 100m, memory: 384Mi}, limits: {cpu: "1", memory: 768Mi}}
          volumeMounts:
            - {name: data, mountPath: /var/lib/manticore}
            - {name: config, mountPath: /etc/manticoresearch}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: piler-index}}
        - {name: source, configMap: {name: piler-manticore}}
        - {name: config, emptyDir: {}}
---
apiVersion: v1
kind: Service
metadata: {name: piler-manticore, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  selector: {app.kubernetes.io/name: piler-manticore}
  ports: [{name: mysql, port: 9306}, {name: readonly, port: 9307}, {name: native, port: 9312}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: piler-memcached, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: piler-memcached}}
  template:
    metadata: {labels: {app.kubernetes.io/name: piler-memcached, app.kubernetes.io/part-of: platform-bus}}
    spec:
      containers:
        - name: memcached
          image: "{{ k3s_platform_apps_piler_memcached_image }}"
          args: ["-m", "64"]
          ports: [{name: memcached, containerPort: 11211}]
          resources: {requests: {cpu: 10m, memory: 80Mi}, limits: {cpu: 200m, memory: 128Mi}}
---
apiVersion: v1
kind: Service
metadata: {name: piler-memcached, namespace: "{{ k3s_platform_apps_namespace }}"}
spec: {selector: {app.kubernetes.io/name: piler-memcached}, ports: [{name: memcached, port: 11211}]}
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: piler, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  serviceName: piler
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: piler}}
  template:
    metadata: {labels: {app.kubernetes.io/name: piler, app.kubernetes.io/part-of: platform-bus}}
    spec:
      containers:
        - name: piler
          image: "{{ k3s_platform_apps_piler_image }}"
          env:
            - {name: PILER_HOSTNAME, value: "{{ k3s_platform_apps_piler_domain }}"}
            - {name: MYSQL_HOSTNAME, value: piler-mariadb}
            - {name: MYSQL_DATABASE, value: piler}
            - {name: MYSQL_USER, value: piler}
            - {name: MYSQL_PASSWORD, valueFrom: {secretKeyRef: {name: piler-runtime, key: MYSQL_PASSWORD}}}
            - {name: ADMIN_USER_PASSWORD_HASH, valueFrom: {secretKeyRef: {name: piler-runtime, key: ADMIN_USER_PASSWORD_HASH}}}
            - {name: LDAP_PASSWORD, valueFrom: {secretKeyRef: {name: piler-runtime, key: LDAP_PASSWORD}}}
            - {name: MANTICORE_HOSTNAME, value: piler-manticore}
            - {name: MEMCACHED_HOSTNAME, value: piler-memcached}
            - {name: RT, value: "1"}
          ports: [{name: http, containerPort: 80}, {name: smtp, containerPort: 25}]
          lifecycle:
            postStart:
              exec:
                command:
                  - /bin/bash
                  - -ec
                  - |
                    for n in {1..120}; do
                      [[ -f /etc/piler/config-site.php && -f /etc/nginx/sites-enabled/piler-nginx.conf ]] && break
                      sleep 1
                    done
                    grep -q "PLATFORMBUS_SSO" /etc/piler/config-site.php || cat >> /etc/piler/config-site.php <<EOF
                    // PLATFORMBUS_SSO
                    \$config['ENABLE_SSO_LOGIN'] = 1;
                    \$config['LDAP_HOST'] = 'ak-outpost-platform-ldap';
                    \$config['LDAP_PORT'] = 389;
                    \$config['LDAP_HELPER_DN'] = 'cn=piler-ldap,ou=users,dc=bus,dc=lenmail,dc=de';
                    \$config['LDAP_HELPER_PASSWORD'] = '$LDAP_PASSWORD';
                    \$config['LDAP_BASE_DN'] = 'ou=users,dc=bus,dc=lenmail,dc=de';
                    \$config['LDAP_MAIL_ATTR'] = 'mail';
                    \$config['LDAP_ACCOUNT_OBJECTCLASS'] = 'user';
                    \$config['LDAP_DISTRIBUTIONLIST_OBJECTCLASS'] = 'group';
                    \$config['LDAP_DISTRIBUTIONLIST_ATTR'] = 'member';
                    EOF
                    sed -i '/fastcgi_param REMOTE_USER \$http_x_authentik_username;/d' /etc/nginx/sites-enabled/piler-nginx.conf
                    sed -i '/include fastcgi_params;/a\              fastcgi_param REMOTE_USER $http_x_authentik_username;' /etc/nginx/sites-enabled/piler-nginx.conf
                    for n in {1..60}; do
                      [[ -f /run/nginx.pid ]] && break
                      sleep 1
                    done
                    nginx -t && nginx -s reload || true
                    service php8.5-fpm reload || true
          readinessProbe: {httpGet: {path: /login.php, port: http}, initialDelaySeconds: 30, periodSeconds: 15}
          livenessProbe: {tcpSocket: {port: smtp}, initialDelaySeconds: 60, periodSeconds: 30}
          resources: {requests: {cpu: 150m, memory: 512Mi}, limits: {cpu: "1", memory: 1Gi}}
          volumeMounts:
            - {name: config, mountPath: /etc/piler}
            - {name: store, mountPath: /var/piler/store}
      volumes:
        - {name: config, persistentVolumeClaim: {claimName: piler-config}}
        - {name: store, persistentVolumeClaim: {claimName: piler-store}}
---
apiVersion: v1
kind: Service
metadata: {name: piler, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  selector: {app.kubernetes.io/name: piler}
  ports: [{name: http, port: 80}, {name: smtp, port: 25}]
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: piler
  namespace: "{{ k3s_platform_apps_namespace }}"
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
    traefik.ingress.kubernetes.io/router.middlewares: "{{ k3s_platform_apps_namespace }}-piler-forwardauth@kubernetescrd"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls: [{secretName: piler-tls, hosts: ["{{ k3s_platform_apps_piler_domain }}"]}]
  rules:
    - host: "{{ k3s_platform_apps_piler_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend: {service: {name: piler, port: {name: http}}}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata: {name: piler-forwardauth, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  forwardAuth:
    address: "{{ k3s_platform_apps_forwardauth_address }}"
    trustForwardHeader: true
    authResponseHeaders: [X-authentik-username, X-authentik-email, X-authentik-groups, X-authentik-uid]
{% endif %}
