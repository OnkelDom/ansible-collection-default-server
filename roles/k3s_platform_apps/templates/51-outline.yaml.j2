{% if k3s_platform_apps_outline_enabled | bool %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: outline-data
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: outline
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_outline_storage_size }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: outline
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: outline
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_outline_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: outline
  template:
    metadata:
      labels:
        app.kubernetes.io/name: outline
        app.kubernetes.io/part-of: platform-bus
    spec:
      securityContext:
        fsGroup: 1001
      containers:
        - name: outline
          image: "{{ k3s_platform_apps_outline_image }}"
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -ec
            - |
              export DATABASE_URL="postgres://${OUTLINE_DB_USER}:${OUTLINE_DB_PASS}@{{ k3s_platform_apps_postgres_host }}:5432/${OUTLINE_DB}"
              exec node build/server/index.js
          env:
            - name: NODE_ENV
              value: production
            - name: URL
              value: "https://{{ k3s_platform_apps_outline_domain }}"
            - name: SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: OUTLINE_SECRET_KEY
            - name: UTILS_SECRET
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: OUTLINE_UTILS_SECRET
            - name: OUTLINE_DB
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: OUTLINE_DB
            - name: OUTLINE_DB_USER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: OUTLINE_DB_USER
            - name: OUTLINE_DB_PASS
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: OUTLINE_DB_PASS
            - name: PGSSLMODE
              value: disable
            - name: REDIS_URL
              value: redis://redis:6379/2
            - name: REDIS_COLLABORATION_URL
              value: redis://redis:6379/5
            - name: FILE_STORAGE
              value: local
            - name: FILE_STORAGE_LOCAL_ROOT_DIR
              value: /var/lib/outline/data
            - name: SMTP_HOST
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_HOST
            - name: SMTP_PORT
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_PORT
            - name: SMTP_USERNAME
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_USERNAME
            - name: SMTP_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_PASSWORD
            - name: SMTP_SECURE
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_TLS
            - name: SMTP_FROM_EMAIL
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_FROM
            - name: OIDC_CLIENT_ID
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: OUTLINE_OIDC_CLIENT_ID
            - name: OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: OUTLINE_OIDC_CLIENT_SECRET
            - name: OIDC_AUTH_URI
              value: "https://{{ k3s_platform_apps_authentik_domain }}/application/o/authorize/"
            - name: OIDC_TOKEN_URI
              value: "https://{{ k3s_platform_apps_authentik_domain }}/application/o/token/"
            - name: OIDC_USERINFO_URI
              value: "https://{{ k3s_platform_apps_authentik_domain }}/application/o/userinfo/"
            - name: OIDC_USERNAME_CLAIM
              value: preferred_username
            - name: OIDC_DISPLAY_NAME
              value: Authentik
            - name: OIDC_SCOPES
              value: openid profile email
          ports:
            - name: http
              containerPort: 3000
          readinessProbe:
            httpGet:
              path: /_health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 15
          livenessProbe:
            httpGet:
              path: /_health
              port: http
            initialDelaySeconds: 90
            periodSeconds: 30
          volumeMounts:
            - name: data
              mountPath: /var/lib/outline/data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: outline-data
---
apiVersion: v1
kind: Service
metadata:
  name: outline
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: outline
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: outline
  ports:
    - name: http
      port: 3000
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: outline
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: outline
    app.kubernetes.io/part-of: platform-bus
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: outline-tls
      hosts:
        - "{{ k3s_platform_apps_outline_domain }}"
  rules:
    - host: "{{ k3s_platform_apps_outline_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: outline
                port:
                  name: http
{% endif %}
