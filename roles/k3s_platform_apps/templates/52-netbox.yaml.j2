{% if k3s_platform_apps_netbox_enabled | bool %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: netbox-extra-config
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: netbox
    app.kubernetes.io/part-of: platform-bus
data:
  extra.py: |
    from os import environ

    def _read_secret(secret_name: str, default: str = "") -> str:
        try:
            with open(f"/run/secrets/{secret_name}", encoding="utf-8") as secret_file:
                return secret_file.readline().strip()
        except OSError:
            return default

    def _as_bool(value: str | None, default: bool = False) -> bool:
        if value is None:
            return default
        return value.lower() in {"1", "true", "yes", "on"}

    if _as_bool(environ.get("NETBOX_BRANCHING_ENABLED"), False):
        from netbox_branching.utilities import DynamicSchemaDict

        _database = {
            "default": {
                "NAME": environ.get("DB_NAME", "netbox"),
                "USER": environ.get("DB_USER", ""),
                "PASSWORD": _read_secret("db_password", environ.get("DB_PASSWORD", "")),
                "HOST": environ.get("DB_HOST", "localhost"),
                "PORT": environ.get("DB_PORT", ""),
                "OPTIONS": {"sslmode": environ.get("DB_SSLMODE", "prefer")},
                "CONN_MAX_AGE": int(environ.get("DB_CONN_MAX_AGE", "300")),
                "DISABLE_SERVER_SIDE_CURSORS": _as_bool(environ.get("DB_DISABLE_SERVER_SIDE_CURSORS"), False),
            }
        }

        PLUGINS = list(globals().get("PLUGINS", []))
        if "netbox_branching" not in PLUGINS:
            PLUGINS.append("netbox_branching")

        PLUGINS_CONFIG = dict(globals().get("PLUGINS_CONFIG", {}))
        PLUGINS_CONFIG.setdefault("netbox_branching", {})

        DATABASES = DynamicSchemaDict(_database)
        DATABASE_ROUTERS = ["netbox_branching.database.BranchAwareRouter"]
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: netbox-media
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: netbox
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_netbox_storage_size }}"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: netbox-reports
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: netbox
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: netbox-scripts
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: netbox
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: 1Gi
{% set netbox_env %}
            - name: DB_HOST
              value: "{{ k3s_platform_apps_postgres_host }}"
            - name: DB_NAME
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: NETBOX_DB
            - name: DB_USER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: NETBOX_DB_USER
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: NETBOX_DB_PASS
            - name: REDIS_HOST
              value: redis
            - name: REDIS_PORT
              value: "6379"
            - name: REDIS_DATABASE
              value: "3"
            - name: REDIS_CACHE_HOST
              value: redis
            - name: REDIS_CACHE_PORT
              value: "6379"
            - name: REDIS_CACHE_DATABASE
              value: "4"
            - name: SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: NETBOX_SECRET_KEY
            - name: ALLOWED_HOSTS
              value: "{{ k3s_platform_apps_netbox_domain }} cmdb.{{ k3s_platform_apps_product_domain }} localhost 127.0.0.1"
            - name: CSRF_TRUSTED_ORIGINS
              value: "https://{{ k3s_platform_apps_netbox_domain }} https://cmdb.{{ k3s_platform_apps_product_domain }}"
            - name: API_TOKEN_PEPPER_1
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: NETBOX_API_TOKEN_PEPPER
            - name: EMAIL_SERVER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_HOST
            - name: EMAIL_PORT
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_PORT
            - name: EMAIL_FROM
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_FROM
            - name: METRICS_ENABLED
              value: "true"
            - name: REMOTE_AUTH_ENABLED
              value: "true"
            - name: REMOTE_AUTH_BACKEND
              value: social_core.backends.open_id_connect.OpenIdConnectAuth
            - name: REMOTE_AUTH_AUTO_CREATE_USER
              value: "true"
            - name: REMOTE_AUTH_GROUP_SYNC_ENABLED
              value: "true"
            - name: REMOTE_AUTH_STAFF_GROUPS
              value: netbox-admins
            - name: REMOTE_AUTH_SUPERUSER_GROUPS
              value: netbox-admins
            - name: SOCIAL_AUTH_OIDC_OIDC_ENDPOINT
              value: "https://{{ k3s_platform_apps_authentik_domain }}/application/o/netbox/"
            - name: SOCIAL_AUTH_OIDC_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: NETBOX_OIDC_CLIENT_ID
            - name: SOCIAL_AUTH_OIDC_SECRET
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: NETBOX_OIDC_CLIENT_SECRET
            - name: SOCIAL_AUTH_OIDC_SCOPE
              value: openid profile email groups
            - name: LOGOUT_REDIRECT_URL
              value: "https://{{ k3s_platform_apps_authentik_domain }}/application/o/netbox/end-session/"
            - name: NETBOX_BRANCHING_ENABLED
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: NETBOX_BRANCHING_ENABLED
                  optional: true
{% endset %}
{% set netbox_mounts %}
            - name: media
              mountPath: /opt/netbox/netbox/media
            - name: reports
              mountPath: /opt/netbox/netbox/reports
            - name: scripts
              mountPath: /opt/netbox/netbox/scripts
            - name: extra-config
              mountPath: /etc/netbox/config/extra.py
              subPath: extra.py
              readOnly: true
{% endset %}
{% set netbox_volumes %}
        - name: media
          persistentVolumeClaim:
            claimName: netbox-media
        - name: reports
          persistentVolumeClaim:
            claimName: netbox-reports
        - name: scripts
          persistentVolumeClaim:
            claimName: netbox-scripts
        - name: extra-config
          configMap:
            name: netbox-extra-config
{% endset %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: netbox
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: netbox
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_netbox_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: netbox
  template:
    metadata:
      labels:
        app.kubernetes.io/name: netbox
        app.kubernetes.io/part-of: platform-bus
    spec:
{% if k3s_platform_apps_netbox_node_selector | length > 0 %}
      nodeSelector:
{{ k3s_platform_apps_netbox_node_selector | to_nice_yaml(indent=2) | indent(8, true) }}
{% endif %}
      securityContext:
        fsGroup: 1000
      containers:
        - name: netbox
          image: "{{ k3s_platform_apps_netbox_image }}"
          imagePullPolicy: IfNotPresent
          env:
{{ netbox_env }}
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /login/
              port: http
              httpHeaders:
                - name: Host
                  value: "{{ k3s_platform_apps_netbox_domain }}"
            initialDelaySeconds: 60
            periodSeconds: 20
            timeoutSeconds: 10
          livenessProbe:
            httpGet:
              path: /login/
              port: http
              httpHeaders:
                - name: Host
                  value: "{{ k3s_platform_apps_netbox_domain }}"
            initialDelaySeconds: 180
            periodSeconds: 30
            timeoutSeconds: 10
          volumeMounts:
{{ netbox_mounts }}
      volumes:
{{ netbox_volumes }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: netbox-worker
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: netbox-worker
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_netbox_worker_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: netbox-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: netbox-worker
        app.kubernetes.io/part-of: platform-bus
    spec:
{% if k3s_platform_apps_netbox_node_selector | length > 0 %}
      nodeSelector:
{{ k3s_platform_apps_netbox_node_selector | to_nice_yaml(indent=2) | indent(8, true) }}
{% endif %}
      affinity:
        podAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: app.kubernetes.io/name
                    operator: In
                    values:
                      - netbox
              topologyKey: kubernetes.io/hostname
      securityContext:
        fsGroup: 1000
      containers:
        - name: netbox-worker
          image: "{{ k3s_platform_apps_netbox_image }}"
          imagePullPolicy: IfNotPresent
          command:
            - /opt/netbox/venv/bin/python
            - /opt/netbox/netbox/manage.py
            - rqworker
          env:
{{ netbox_env }}
          volumeMounts:
{{ netbox_mounts }}
      volumes:
{{ netbox_volumes }}
---
apiVersion: v1
kind: Service
metadata:
  name: netbox
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: netbox
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: netbox
  ports:
    - name: http
      port: 8080
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: netbox
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: netbox
    app.kubernetes.io/part-of: platform-bus
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: netbox-tls
      hosts:
        - "{{ k3s_platform_apps_netbox_domain }}"
  rules:
    - host: "{{ k3s_platform_apps_netbox_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: netbox
                port:
                  name: http
{% endif %}
