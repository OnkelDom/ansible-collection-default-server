{% if k3s_platform_apps_matrix_enabled | bool %}
---
apiVersion: v1
kind: Secret
metadata: {name: matrix-runtime, namespace: "{{ k3s_platform_apps_namespace }}"}
type: Opaque
stringData:
  database-password: {{ k3s_platform_apps_matrix_database_password | to_json }}
  registration-secret: {{ k3s_platform_apps_matrix_registration_secret | to_json }}
  macaroon-secret: {{ k3s_platform_apps_matrix_macaroon_secret | to_json }}
  form-secret: {{ k3s_platform_apps_matrix_form_secret | to_json }}
  signing.key: {{ k3s_platform_apps_matrix_signing_key | to_json }}
  turn-secret: {{ k3s_platform_apps_matrix_turn_secret | to_json }}
---
apiVersion: v1
kind: ConfigMap
metadata: {name: matrix-config, namespace: "{{ k3s_platform_apps_namespace }}"}
data:
  homeserver.yaml: |
    server_name: "{{ k3s_platform_apps_matrix_server_name }}"
    public_baseurl: "https://{{ k3s_platform_apps_matrix_domain }}/"
    pid_file: /data/homeserver.pid
    web_client_location: "https://{{ k3s_platform_apps_matrix_element_domain }}/"
    listeners:
      - port: 8008
        tls: false
        type: http
        x_forwarded: true
        resources:
          - names: [client, federation]
            compress: false
      - port: 9000
        tls: false
        type: metrics
    database:
      name: psycopg2
      args:
        user: synapse
        password: "__DATABASE_PASSWORD__"
        database: synapse
        host: matrix-postgres
        cp_min: 2
        cp_max: 5
    log_config: /config/log.config
    media_store_path: /data/media_store
    signing_key_path: /matrix-secrets/signing.key
    registration_shared_secret: "__REGISTRATION_SECRET__"
    macaroon_secret_key: "__MACAROON_SECRET__"
    form_secret: "__FORM_SECRET__"
    enable_registration: false
    password_config:
      enabled: false
    report_stats: false
    enable_metrics: {{ k3s_platform_apps_matrix_metrics_enabled | bool | lower }}
{% if k3s_platform_apps_matrix_turn_enabled | bool %}
    turn_uris:
      - "turn:{{ k3s_platform_apps_matrix_turn_domain }}:{{ k3s_platform_apps_matrix_turn_port }}?transport=udp"
      - "turn:{{ k3s_platform_apps_matrix_turn_domain }}:{{ k3s_platform_apps_matrix_turn_port }}?transport=tcp"
    turn_shared_secret: "__TURN_SECRET__"
    turn_user_lifetime: 1h
    turn_allow_guests: false
{% endif %}
    trusted_key_servers:
      - server_name: matrix.org
    oidc_providers:
      - idp_id: authentik
        idp_name: Authentik
        discover: true
        issuer: "{{ k3s_platform_apps_matrix_oidc_issuer }}"
        client_id: "{{ k3s_platform_apps_matrix_oidc_client_id }}"
        client_secret: "__OIDC_CLIENT_SECRET__"
        scopes: [openid, profile, email]
        user_mapping_provider:
          config:
            localpart_template: "{{ '{{ user.preferred_username }}' }}"
            display_name_template: "{{ '{{ user.name }}' }}"
            email_template: "{{ '{{ user.email }}' }}"
    suppress_key_server_warning: true
  log.config: |
    version: 1
    formatters:
      precise: {format: '%(asctime)s %(levelname)s %(name)s %(message)s'}
    handlers:
      console: {class: logging.StreamHandler, formatter: precise}
    root: {level: INFO, handlers: [console]}
    disable_existing_loggers: false
  element.json: |
    {
      "default_server_config": {
        "m.homeserver": {"base_url": "https://{{ k3s_platform_apps_matrix_domain }}", "server_name": "{{ k3s_platform_apps_matrix_server_name }}"}
      },
      "disable_custom_urls": true,
      "disable_guests": true,
      "brand": "LenMail Chat",
      "default_theme": "dark",
      "room_directory": {"servers": ["{{ k3s_platform_apps_matrix_server_name }}"]}
    }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: {name: matrix-postgres, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: ceph-rbd
  resources: {requests: {storage: "{{ k3s_platform_apps_matrix_database_size }}"}}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: {name: matrix-media, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: ceph-rbd
  resources: {requests: {storage: "{{ k3s_platform_apps_matrix_media_size }}"}}
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: matrix-postgres, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  serviceName: matrix-postgres
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: matrix-postgres}}
  template:
    metadata: {labels: {app.kubernetes.io/name: matrix-postgres, app.kubernetes.io/part-of: platform-bus}}
    spec:
      securityContext: {runAsNonRoot: true, runAsUser: 70, runAsGroup: 70, seccompProfile: {type: RuntimeDefault}}
      initContainers:
        - name: ensure-data-permissions
          image: "docker.io/library/busybox:1.37"
          command: [/bin/sh, -ec]
          args: ["chmod 0700 /var/lib/postgresql/data"]
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
          volumeMounts: [{name: data, mountPath: /var/lib/postgresql/data}]
      containers:
        - name: postgres
          image: "{{ k3s_platform_apps_matrix_postgres_image }}"
          command: [postgres]
          args: ["-c", "unix_socket_directories=/tmp"]
          env:
            - {name: POSTGRES_DB, value: synapse}
            - {name: POSTGRES_USER, value: synapse}
            - {name: POSTGRES_INITDB_ARGS, value: "--encoding=UTF8 --locale=C"}
            - {name: POSTGRES_PASSWORD, valueFrom: {secretKeyRef: {name: matrix-runtime, key: database-password}}}
          ports: [{name: postgres, containerPort: 5432}]
          readinessProbe: {exec: {command: [pg_isready, -h, 127.0.0.1, -U, synapse]}, initialDelaySeconds: 10, periodSeconds: 10}
          resources: {requests: {cpu: 50m, memory: 160Mi}, limits: {cpu: 500m, memory: 512Mi}}
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
          volumeMounts: [{name: data, mountPath: /var/lib/postgresql/data}]
      volumes: [{name: data, persistentVolumeClaim: {claimName: matrix-postgres}}]
---
apiVersion: v1
kind: Service
metadata: {name: matrix-postgres, namespace: "{{ k3s_platform_apps_namespace }}"}
spec: {selector: {app.kubernetes.io/name: matrix-postgres}, ports: [{name: postgres, port: 5432}]}
---
apiVersion: apps/v1
kind: StatefulSet
metadata: {name: matrix-synapse, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  serviceName: matrix-synapse
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: matrix-synapse}}
  template:
    metadata: {labels: {app.kubernetes.io/name: matrix-synapse, app.kubernetes.io/part-of: platform-bus}}
    spec:
      securityContext: {runAsNonRoot: true, runAsUser: 991, runAsGroup: 991, fsGroup: 991, seccompProfile: {type: RuntimeDefault}}
      initContainers:
        - name: render-config
          image: "docker.io/library/busybox:1.37"
          command: [/bin/sh, -ec]
          env:
            - {name: DATABASE_PASSWORD, valueFrom: {secretKeyRef: {name: matrix-runtime, key: database-password}}}
            - {name: REGISTRATION_SECRET, valueFrom: {secretKeyRef: {name: matrix-runtime, key: registration-secret}}}
            - {name: MACAROON_SECRET, valueFrom: {secretKeyRef: {name: matrix-runtime, key: macaroon-secret}}}
            - {name: FORM_SECRET, valueFrom: {secretKeyRef: {name: matrix-runtime, key: form-secret}}}
            - {name: OIDC_CLIENT_SECRET, valueFrom: {secretKeyRef: {name: matrix-oidc, key: client-secret}}}
            - {name: TURN_SECRET, valueFrom: {secretKeyRef: {name: matrix-runtime, key: turn-secret}}}
          volumeMounts:
            - {name: source, mountPath: /source, readOnly: true}
            - {name: rendered, mountPath: /rendered}
            - {name: media, mountPath: /data}
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
          args:
            - |
              cp /source/homeserver.yaml /rendered/homeserver.yaml
              cp /source/log.config /rendered/log.config
              sed -i "s|__DATABASE_PASSWORD__|$DATABASE_PASSWORD|g; s|__REGISTRATION_SECRET__|$REGISTRATION_SECRET|g; s|__MACAROON_SECRET__|$MACAROON_SECRET|g; s|__FORM_SECRET__|$FORM_SECRET|g; s|__OIDC_CLIENT_SECRET__|$OIDC_CLIENT_SECRET|g; s|__TURN_SECRET__|$TURN_SECRET|g" /rendered/homeserver.yaml
      containers:
        - name: synapse
          image: "{{ k3s_platform_apps_matrix_synapse_image }}"
          args: [run, -c, /config/homeserver.yaml]
          ports: [{name: http, containerPort: 8008}, {name: metrics, containerPort: 9000}]
          readinessProbe: {httpGet: {path: /_matrix/client/versions, port: http}, initialDelaySeconds: 20, periodSeconds: 10}
          livenessProbe: {httpGet: {path: /health, port: http}, initialDelaySeconds: 60, periodSeconds: 30}
          resources: {requests: {cpu: 100m, memory: 384Mi}, limits: {cpu: "1", memory: 1Gi}}
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
          volumeMounts:
            - {name: rendered, mountPath: /config, readOnly: true}
            - {name: signing, mountPath: /matrix-secrets, readOnly: true}
            - {name: media, mountPath: /data}
      volumes:
        - {name: source, configMap: {name: matrix-config}}
        - {name: rendered, emptyDir: {}}
        - {name: signing, secret: {secretName: matrix-runtime, items: [{key: signing.key, path: signing.key}]}}
        - {name: media, persistentVolumeClaim: {claimName: matrix-media}}
---
apiVersion: v1
kind: Service
metadata: {name: matrix-synapse, namespace: "{{ k3s_platform_apps_namespace }}", labels: {app.kubernetes.io/name: matrix-synapse}}
spec: {selector: {app.kubernetes.io/name: matrix-synapse}, ports: [{name: http, port: 8008}, {name: metrics, port: 9000}]}
{% if k3s_platform_apps_matrix_turn_enabled | bool %}
---
apiVersion: apps/v1
kind: DaemonSet
metadata: {name: matrix-turn, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  selector: {matchLabels: {app.kubernetes.io/name: matrix-turn}}
  template:
    metadata: {labels: {app.kubernetes.io/name: matrix-turn, app.kubernetes.io/part-of: platform-bus}}
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations:
        - {key: node-role.kubernetes.io/control-plane, operator: Exists, effect: NoSchedule}
        - {key: node-role.kubernetes.io/etcd, operator: Exists, effect: NoExecute}
      securityContext: {seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: coturn
          image: "{{ k3s_platform_apps_matrix_turn_image }}"
          command: [/usr/bin/turnserver]
          args:
            - --log-file=stdout
            - --fingerprint
            - --use-auth-secret
            - --static-auth-secret=$(TURN_SECRET)
            - --realm={{ k3s_platform_apps_matrix_turn_domain }}
            - --listening-port={{ k3s_platform_apps_matrix_turn_port }}
            - --min-port={{ k3s_platform_apps_matrix_turn_relay_min_port }}
            - --max-port={{ k3s_platform_apps_matrix_turn_relay_max_port }}
            - --no-cli
            - --no-multicast-peers
          env: [{name: TURN_SECRET, valueFrom: {secretKeyRef: {name: matrix-runtime, key: turn-secret}}}]
          ports:
            - {name: turn-udp, containerPort: {{ k3s_platform_apps_matrix_turn_port }}, hostPort: {{ k3s_platform_apps_matrix_turn_port }}, protocol: UDP}
            - {name: turn-tcp, containerPort: {{ k3s_platform_apps_matrix_turn_port }}, hostPort: {{ k3s_platform_apps_matrix_turn_port }}, protocol: TCP}
          resources: {requests: {cpu: 20m, memory: 32Mi}, limits: {cpu: 300m, memory: 128Mi}}
          securityContext: {runAsUser: 0}
{% endif %}
{% if k3s_platform_apps_matrix_metrics_enabled | bool %}
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: matrix-synapse
  namespace: monitoring
  labels: {release: kube-prometheus-stack}
spec:
  namespaceSelector: {matchNames: ["{{ k3s_platform_apps_namespace }}"]}
  selector: {matchLabels: {app.kubernetes.io/name: matrix-synapse}}
  endpoints: [{port: metrics, interval: 30s}]
---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: matrix
  namespace: monitoring
  labels: {release: kube-prometheus-stack}
spec:
  groups:
    - name: matrix.rules
      rules:
        - alert: MatrixSynapseDown
          expr: absent(up{service="matrix-synapse"} == 1)
          for: 5m
          labels: {severity: critical, service: matrix}
          annotations: {summary: "Matrix Synapse metrics unavailable"}
        - alert: MatrixPodRestarting
          expr: increase(kube_pod_container_status_restarts_total{namespace="{{ k3s_platform_apps_namespace }}",pod=~"matrix-.*"}[15m]) > 0
          for: 2m
          labels: {severity: warning, service: matrix}
          annotations: {summary: "A Matrix workload restarted"}
        - alert: MatrixPVCAlmostFull
          expr: kubelet_volume_stats_available_bytes{namespace="{{ k3s_platform_apps_namespace }}",persistentvolumeclaim=~"matrix-.*"} / kubelet_volume_stats_capacity_bytes < 0.15
          for: 10m
          labels: {severity: warning, service: matrix}
          annotations: {summary: "Matrix persistent storage is almost full"}
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: matrix-element, namespace: "{{ k3s_platform_apps_namespace }}"}
spec:
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: matrix-element}}
  template:
    metadata: {labels: {app.kubernetes.io/name: matrix-element, app.kubernetes.io/part-of: platform-bus}}
    spec:
      containers:
        - name: element
          image: "{{ k3s_platform_apps_matrix_element_image }}"
          ports: [{name: http, containerPort: 80}]
          readinessProbe: {httpGet: {path: /, port: http}, initialDelaySeconds: 10, periodSeconds: 10}
          resources: {requests: {cpu: 20m, memory: 64Mi}, limits: {cpu: 250m, memory: 192Mi}}
          volumeMounts: [{name: config, mountPath: /app/config.json, subPath: element.json, readOnly: true}]
      volumes: [{name: config, configMap: {name: matrix-config}}]
---
apiVersion: v1
kind: Service
metadata: {name: matrix-element, namespace: "{{ k3s_platform_apps_namespace }}"}
spec: {selector: {app.kubernetes.io/name: matrix-element}, ports: [{name: http, port: 80}]}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: matrix-synapse
  namespace: "{{ k3s_platform_apps_namespace }}"
  annotations: {cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"}
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls: [{secretName: matrix-tls, hosts: ["{{ k3s_platform_apps_matrix_domain }}"]}]
  rules:
    - host: "{{ k3s_platform_apps_matrix_domain }}"
      http:
        paths:
          - {path: /, pathType: Prefix, backend: {service: {name: matrix-synapse, port: {name: http}}}}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: matrix-element
  namespace: "{{ k3s_platform_apps_namespace }}"
  annotations: {cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"}
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls: [{secretName: matrix-element-tls, hosts: ["{{ k3s_platform_apps_matrix_element_domain }}"]}]
  rules:
    - host: "{{ k3s_platform_apps_matrix_element_domain }}"
      http:
        paths:
          - {path: /, pathType: Prefix, backend: {service: {name: matrix-element, port: {name: http}}}}
{% endif %}
