{% if k3s_platform_apps_product_aliases_enabled | bool %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: product-aliases
  namespace: "{{ k3s_platform_apps_namespace }}"
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: product-aliases-tls
      hosts:
        - auth.{{ k3s_platform_apps_product_domain }}
        - git.{{ k3s_platform_apps_product_domain }}
        - wiki.{{ k3s_platform_apps_product_domain }}
        - cmdb.{{ k3s_platform_apps_product_domain }}
        - ops.{{ k3s_platform_apps_product_domain }}
  rules:
{% for alias in [
  {'host': 'auth', 'service': 'authentik-server', 'port': 'http'},
  {'host': 'git', 'service': 'gitea', 'port': 'http'},
  {'host': 'wiki', 'service': 'outline', 'port': 'http'},
  {'host': 'cmdb', 'service': 'netbox', 'port': 'http'},
  {'host': 'ops', 'service': 'semaphore', 'port': 'http'}
] %}
    - host: "{{ alias.host }}.{{ k3s_platform_apps_product_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "{{ alias.service }}"
                port:
                  name: "{{ alias.port }}"
{% endfor %}
{% if k3s_platform_apps_forwardauth_enabled | bool %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: product-forwardauth-aliases
  namespace: "{{ k3s_platform_apps_namespace }}"
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
    traefik.ingress.kubernetes.io/router.middlewares: "{{ k3s_platform_apps_namespace }}-authentik-forwardauth@kubernetescrd"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: product-forwardauth-aliases-tls
      hosts:
        - portal.{{ k3s_platform_apps_product_domain }}
        - n8n.{{ k3s_platform_apps_product_domain }}
  rules:
{% for alias in [
  {'host': 'portal', 'service': 'homepage', 'port': 'http'},
  {'host': 'n8n', 'service': 'n8n', 'port': 'http'}
] %}
    - host: "{{ alias.host }}.{{ k3s_platform_apps_product_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "{{ alias.service }}"
                port:
                  name: "{{ alias.port }}"
{% endfor %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: product-n8n-machine-endpoints
  namespace: "{{ k3s_platform_apps_namespace }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  rules:
    - host: "n8n.{{ k3s_platform_apps_product_domain }}"
      http:
        paths:
{% for path in ['/webhook/', '/webhook-test/', '/webhook-waiting/', '/form/', '/form-test/', '/healthz'] %}
          - path: "{{ path }}"
            pathType: Prefix
            backend:
              service:
                name: n8n
                port:
                  name: http
{% endfor %}
{% endif %}
{% endif %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: product-observability-aliases
  namespace: monitoring
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: product-observability-aliases-tls
      hosts:
        - dash.{{ k3s_platform_apps_product_domain }}
        - logs.{{ k3s_platform_apps_product_domain }}
        - traces.{{ k3s_platform_apps_product_domain }}
  rules:
{% for alias in [
  {'host': 'dash', 'service': 'kube-prometheus-stack-grafana', 'port': 80},
  {'host': 'logs', 'service': 'loki', 'port': 3100}
] %}
    - host: "{{ alias.host }}.{{ k3s_platform_apps_product_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "{{ alias.service }}"
                port:
                  number: {{ alias.port }}
{% endfor %}
    - host: "traces.{{ k3s_platform_apps_product_domain }}"
      http:
        paths:
          - path: /v1/traces
            pathType: Prefix
            backend:
              service:
                name: tempo
                port:
                  number: 4318
          - path: /
            pathType: Prefix
            backend:
              service:
                name: tempo
                port:
                  number: 3200
{% if k3s_platform_apps_forwardauth_enabled | bool %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: product-observability-forwardauth-aliases
  namespace: monitoring
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
    traefik.ingress.kubernetes.io/router.middlewares: "monitoring-authentik-forwardauth@kubernetescrd"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: product-observability-forwardauth-aliases-tls
      hosts:
        - mon.{{ k3s_platform_apps_product_domain }}
        - alert.{{ k3s_platform_apps_product_domain }}
  rules:
{% for alias in [
  {'host': 'mon', 'service': 'kps-prometheus', 'port': 9090},
  {'host': 'alert', 'service': 'kps-alertmanager', 'port': 9093}
] %}
    - host: "{{ alias.host }}.{{ k3s_platform_apps_product_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "{{ alias.service }}"
                port:
                  number: {{ alias.port }}
{% endfor %}
{% endif %}
