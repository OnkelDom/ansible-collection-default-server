{% if k3s_platform_apps_gitea_enabled | bool %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: gitea-data
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: gitea
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_gitea_storage_size }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gitea
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: gitea
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_gitea_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: gitea
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gitea
        app.kubernetes.io/part-of: platform-bus
    spec:
      enableServiceLinks: false
      securityContext:
        fsGroup: 1000
      containers:
        - name: gitea
          image: "{{ k3s_platform_apps_gitea_image }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: USER_UID
              value: "1000"
            - name: USER_GID
              value: "1000"
            - name: GITEA__database__DB_TYPE
              value: postgres
            - name: GITEA__database__HOST
              value: "{{ k3s_platform_apps_postgres_host }}:5432"
            - name: GITEA__database__NAME
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: GITEA_DB
            - name: GITEA__database__USER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: GITEA_DB_USER
            - name: GITEA__database__PASSWD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: GITEA_DB_PASS
            - name: GITEA__server__ROOT_URL
              value: "https://{{ k3s_platform_apps_gitea_domain }}/"
            - name: GITEA__server__DOMAIN
              value: "{{ k3s_platform_apps_gitea_domain }}"
            - name: GITEA__server__SSH_DOMAIN
              value: "{{ k3s_platform_apps_gitea_ssh_domain }}"
            - name: GITEA__server__SSH_PORT
              value: "{{ k3s_platform_apps_gitea_ssh_port | string }}"
            - name: GITEA__server__LFS_JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: GITEA_LFS_JWT_SECRET
            - name: GITEA__actions__ENABLED
              value: "true"
            - name: GITEA__security__INSTALL_LOCK
              value: "true"
            - name: GITEA__security__SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: GITEA_SECRET_KEY
            - name: GITEA__security__INTERNAL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: GITEA_INTERNAL_TOKEN
            - name: GITEA__service__DISABLE_REGISTRATION
              value: "false"
            - name: GITEA__service__ALLOW_ONLY_EXTERNAL_REGISTRATION
              value: "true"
            - name: GITEA__service__SHOW_REGISTRATION_BUTTON
              value: "false"
            - name: GITEA__openid__ENABLE_OPENID_SIGNIN
              value: "false"
            - name: GITEA__openid__ENABLE_OPENID_SIGNUP
              value: "true"
            - name: GITEA__openid__WHITELISTED_URIS
              value: "{{ k3s_platform_apps_authentik_domain }}"
            - name: GITEA__oauth2_client__ENABLE_AUTO_REGISTRATION
              value: "true"
            - name: GITEA__oauth2_client__REGISTER_EMAIL_CONFIRM
              value: "false"
            - name: GITEA__oauth2_client__ACCOUNT_LINKING
              value: auto
            - name: GITEA__oauth2_client__USERNAME
              value: preferred_username
            - name: GITEA__oauth2_client__OPENID_CONNECT_SCOPES
              value: email profile groups
            - name: GITEA__oauth2_client__UPDATE_AVATAR
              value: "true"
            - name: GITEA__ui__DEFAULT_THEME
              value: "{{ k3s_platform_apps_gitea_default_theme }}"
            - name: GITEA__mailer__ENABLED
              value: "true"
            - name: GITEA__mailer__SMTP_ADDR
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_HOST
            - name: GITEA__mailer__SMTP_PORT
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_PORT
            - name: GITEA__mailer__FROM
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_FROM
            - name: GITEA__mailer__PROTOCOL
              value: smtp
            - name: GITEA__metrics__ENABLED
              value: "true"
          ports:
            - name: http
              containerPort: 3000
            - name: ssh
              containerPort: 22
          readinessProbe:
            httpGet:
              path: /api/healthz
              port: http
              httpHeaders:
                - name: Host
                  value: "{{ k3s_platform_apps_gitea_domain }}"
            initialDelaySeconds: 60
            periodSeconds: 20
            timeoutSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/healthz
              port: http
              httpHeaders:
                - name: Host
                  value: "{{ k3s_platform_apps_gitea_domain }}"
            initialDelaySeconds: 180
            periodSeconds: 30
            timeoutSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: gitea-data
---
apiVersion: v1
kind: Service
metadata:
  name: gitea
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: gitea
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: gitea
  ports:
    - name: http
      port: 3000
      targetPort: http
    - name: ssh
      port: 22
      targetPort: ssh
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gitea
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: gitea
    app.kubernetes.io/part-of: platform-bus
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: gitea-tls
      hosts:
        - "{{ k3s_platform_apps_gitea_domain }}"
  rules:
    - host: "{{ k3s_platform_apps_gitea_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: gitea
                port:
                  name: http
{% if k3s_platform_apps_gitea_ssh_ingress_enabled | bool %}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRouteTCP
metadata:
  name: gitea-ssh
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: gitea
    app.kubernetes.io/part-of: platform-bus
spec:
  entryPoints:
    - gitssh
  routes:
    - match: HostSNI(`*`)
      services:
        - name: gitea
          port: ssh
{% endif %}
{% if k3s_platform_apps_gitea_runner_enabled | bool %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: gitea-runner-data
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: gitea-runner
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_gitea_runner_storage_size }}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: gitea-runner-config
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: gitea-runner
    app.kubernetes.io/part-of: platform-bus
data:
  config.yaml: |-
    log:
      level: info
    runner:
      file: /data/.runner
      capacity: 2
      timeout: 3h
    cache:
      enabled: true
      dir: /data/cache
    container:
      network: bridge
      privileged: false
      valid_volumes: []
      docker_host: tcp://127.0.0.1:2375
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gitea-runner
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: gitea-runner
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_gitea_runner_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: gitea-runner
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gitea-runner
        app.kubernetes.io/part-of: platform-bus
    spec:
      enableServiceLinks: false
      containers:
        - name: runner
          image: "{{ k3s_platform_apps_gitea_runner_image }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: GITEA_INSTANCE_URL
              value: "http://gitea:3000/"
            - name: GITEA_RUNNER_REGISTRATION_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: GITEA_RUNNER_REGISTRATION_TOKEN
            - name: GITEA_RUNNER_NAME
              value: "{{ k3s_platform_apps_gitea_runner_name }}"
            - name: GITEA_RUNNER_LABELS
              value: "{{ k3s_platform_apps_gitea_runner_labels }}"
            - name: CONFIG_FILE
              value: /config.yaml
            - name: DOCKER_HOST
              value: tcp://127.0.0.1:2375
          command:
            - sh
            - -ec
            - |
              until nc -z gitea 3000 && nc -z 127.0.0.1 2375; do
                echo "waiting for gitea and dind"
                sleep 5
              done
              if [ ! -s /data/.runner ]; then
                act_runner register --no-interactive \
                  --config /config.yaml \
                  --instance "$GITEA_INSTANCE_URL" \
                  --token "$GITEA_RUNNER_REGISTRATION_TOKEN" \
                  --name "$GITEA_RUNNER_NAME" \
                  --labels "$GITEA_RUNNER_LABELS"
              fi
              exec act_runner daemon --config /config.yaml
          volumeMounts:
            - name: data
              mountPath: /data
            - name: config
              mountPath: /config.yaml
              subPath: config.yaml
        - name: dind
          image: "{{ k3s_platform_apps_gitea_runner_dind_image }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: DOCKER_TLS_CERTDIR
              value: ""
          securityContext:
            privileged: true
          args:
            - dockerd
            - --host=tcp://127.0.0.1:2375
            - --host=unix:///var/run/docker.sock
          volumeMounts:
            - name: dind-storage
              mountPath: /var/lib/docker
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: gitea-runner-data
        - name: config
          configMap:
            name: gitea-runner-config
        - name: dind-storage
          emptyDir: {}
{% endif %}
{% endif %}
