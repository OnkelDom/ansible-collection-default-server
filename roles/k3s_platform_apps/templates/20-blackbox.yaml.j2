{% if k3s_platform_apps_blackbox_enabled | bool %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: platform-bus-blackbox-config
  namespace: monitoring
  labels:
    app.kubernetes.io/name: platform-bus-blackbox-exporter
    app.kubernetes.io/part-of: platform-bus
data:
  blackbox.yml: |
    modules:
      http_2xx:
        prober: http
        timeout: 10s
        http:
          valid_http_versions:
            - HTTP/1.1
            - HTTP/2.0
          follow_redirects: true
          preferred_ip_protocol: ip4
      tcp_connect:
        prober: tcp
        timeout: 5s
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: platform-bus-blackbox-exporter
  namespace: monitoring
  labels:
    app.kubernetes.io/name: platform-bus-blackbox-exporter
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: platform-bus-blackbox-exporter
  template:
    metadata:
      labels:
        app.kubernetes.io/name: platform-bus-blackbox-exporter
        app.kubernetes.io/part-of: platform-bus
    spec:
      containers:
        - name: blackbox-exporter
          image: "{{ k3s_platform_apps_blackbox_image }}"
          imagePullPolicy: IfNotPresent
          args:
            - --config.file=/etc/blackbox_exporter/blackbox.yml
          ports:
            - name: http
              containerPort: 9115
          volumeMounts:
            - name: config
              mountPath: /etc/blackbox_exporter
              readOnly: true
          readinessProbe:
            httpGet:
              path: /-/ready
              port: http
            initialDelaySeconds: 5
            periodSeconds: 15
          livenessProbe:
            httpGet:
              path: /-/healthy
              port: http
            initialDelaySeconds: 15
            periodSeconds: 30
      volumes:
        - name: config
          configMap:
            name: platform-bus-blackbox-config
---
apiVersion: v1
kind: Service
metadata:
  name: platform-bus-blackbox-exporter
  namespace: monitoring
  labels:
    app.kubernetes.io/name: platform-bus-blackbox-exporter
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: platform-bus-blackbox-exporter
  ports:
    - name: http
      port: 9115
      targetPort: http
{% for target in k3s_platform_apps_blackbox_targets %}
---
apiVersion: monitoring.coreos.com/v1
kind: Probe
metadata:
  name: platform-bus-{{ target.name }}
  namespace: monitoring
  labels:
    release: kube-prometheus-stack
    app.kubernetes.io/part-of: platform-bus
spec:
  interval: 30s
  module: http_2xx
{% if target.hostname is defined %}
  params:
    - name: hostname
      values:
        - "{{ target.hostname }}"
{% endif %}
  prober:
    url: platform-bus-blackbox-exporter.monitoring.svc.cluster.local:9115
    path: /probe
  targets:
    staticConfig:
      static:
        - "{{ target.probe_url | default(target.url) }}"
      labels:
        platform: platform-bus
        environment: k3s
        service: "{{ target.name }}"
        tier: "{{ target.tier | default('application') }}"
        lpm_service_criticality: "{{ target.criticality | default('mid') }}"
        check_type: http
{% endfor %}
{% endif %}
