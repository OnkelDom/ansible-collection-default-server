{% if k3s_platform_apps_semaphore_enabled | bool %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: semaphore-data
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: semaphore
    app.kubernetes.io/part-of: platform-bus
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ceph-rbd
  resources:
    requests:
      storage: "{{ k3s_platform_apps_semaphore_storage_size }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: semaphore
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: semaphore
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_semaphore_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: semaphore
  template:
    metadata:
      labels:
        app.kubernetes.io/name: semaphore
        app.kubernetes.io/part-of: platform-bus
    spec:
      securityContext:
        fsGroup: 1001
      containers:
        - name: semaphore
          image: "{{ k3s_platform_apps_semaphore_image }}"
          imagePullPolicy: IfNotPresent
          env:
            - name: SEMAPHORE_DB_DIALECT
              value: postgres
            - name: SEMAPHORE_DB_HOST
              value: "{{ k3s_platform_apps_postgres_host }}"
            - name: SEMAPHORE_DB_PORT
              value: "5432"
            - name: SEMAPHORE_DB_NAME
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_DB
            - name: SEMAPHORE_DB_USER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_DB_USER
            - name: SEMAPHORE_DB_PASS
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_DB_PASS
            - name: SEMAPHORE_ADMIN
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_ADMIN
            - name: SEMAPHORE_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_ADMIN_PASSWORD
            - name: SEMAPHORE_ADMIN_NAME
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_ADMIN_NAME
            - name: SEMAPHORE_ADMIN_EMAIL
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_ADMIN_EMAIL
            - name: SEMAPHORE_ACCESS_KEY_ENCRYPTION
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_ACCESS_KEY_ENCRYPTION
            - name: SEMAPHORE_EMAIL_HOST
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_HOST
            - name: SEMAPHORE_EMAIL_PORT
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_PORT
            - name: SEMAPHORE_EMAIL_SENDER
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SMTP_FROM
            - name: SEMAPHORE_USE_REMOTE_RUNNER
              value: "True"
            - name: SEMAPHORE_RUNNER_REGISTRATION_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_RUNNER_TOKEN
            - name: SEMAPHORE_PORT
              value: "3000"
            - name: SEMAPHORE_WEB_HOST
              value: "https://{{ k3s_platform_apps_semaphore_domain }}"
            - name: SEMAPHORE_OIDC_CLIENT_ID
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_OIDC_CLIENT_ID
            - name: SEMAPHORE_OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_OIDC_CLIENT_SECRET
            - name: SEMAPHORE_OIDC_PROVIDERS
              value: '{"authentik":{"display_name":"Authentik","provider_url":"https://{{ k3s_platform_apps_authentik_domain }}/application/o/semaphore/","client_id":"$(SEMAPHORE_OIDC_CLIENT_ID)","client_secret":"$(SEMAPHORE_OIDC_CLIENT_SECRET)","redirect_url":"https://{{ k3s_platform_apps_semaphore_domain }}/api/auth/oidc/authentik/redirect/","scopes":["openid","profile","email"],"username_claim":"preferred_username","email_claim":"email","name_claim":"preferred_username","order":1}}'
          ports:
            - name: http
              containerPort: 3000
          readinessProbe:
            httpGet:
              path: /api/ping
              port: http
            initialDelaySeconds: 30
            periodSeconds: 15
            timeoutSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/ping
              port: http
            initialDelaySeconds: 120
            periodSeconds: 30
            timeoutSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /var/lib/semaphore
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: semaphore-data
---
apiVersion: v1
kind: Service
metadata:
  name: semaphore
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: semaphore
    app.kubernetes.io/part-of: platform-bus
spec:
  selector:
    app.kubernetes.io/name: semaphore
  ports:
    - name: http
      port: 3000
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: semaphore
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: semaphore
    app.kubernetes.io/part-of: platform-bus
  annotations:
    cert-manager.io/cluster-issuer: "{{ k3s_platform_apps_acme_cluster_issuer }}"
spec:
  ingressClassName: "{{ k3s_platform_apps_ingress_class }}"
  tls:
    - secretName: semaphore-tls
      hosts:
        - "{{ k3s_platform_apps_semaphore_domain }}"
  rules:
    - host: "{{ k3s_platform_apps_semaphore_domain }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: semaphore
                port:
                  name: http
{% if k3s_platform_apps_semaphore_runner_enabled | bool %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: semaphore-runner
  namespace: "{{ k3s_platform_apps_namespace }}"
  labels:
    app.kubernetes.io/name: semaphore-runner
    app.kubernetes.io/part-of: platform-bus
spec:
  replicas: {{ k3s_platform_apps_semaphore_runner_replicas | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: semaphore-runner
  template:
    metadata:
      labels:
        app.kubernetes.io/name: semaphore-runner
        app.kubernetes.io/part-of: platform-bus
    spec:
      enableServiceLinks: false
      affinity:
        podAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/name: semaphore
              topologyKey: kubernetes.io/hostname
      containers:
        - name: semaphore-runner
          image: "{{ k3s_platform_apps_semaphore_runner_image }}"
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 0
          command:
            - /bin/sh
            - -lc
            - |
              if command -v apk >/dev/null 2>&1; then
                apk --no-cache add ansible-core docker-cli openssh-client git
              fi
              exec su semaphore -s /bin/sh -c '/usr/local/bin/runner-wrapper'
          env:
            - name: SEMAPHORE_WEB_ROOT
              value: http://semaphore:3000
            - name: SEMAPHORE_RUNNER_REGISTRATION_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ k3s_platform_apps_runtime_secret_name }}"
                  key: SEMAPHORE_RUNNER_TOKEN
            - name: SEMAPHORE_RUNNER_PRIVATE_KEY_FILE
              value: /var/lib/semaphore/runner.key
            - name: SEMAPHORE_RUNNER_NAME
              value: "{{ k3s_platform_apps_semaphore_runner_name }}"
            - name: ANSIBLE_HOST_KEY_CHECKING
              value: "False"
          volumeMounts:
            - name: data
              mountPath: /var/lib/semaphore
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: semaphore-data
{% endif %}
{% endif %}
