---
apiVersion: v1
kind: Secret
metadata:
  name: "{{ k3s_postgres_ha_cluster_name }}-bootstrap-owner"
  namespace: "{{ k3s_postgres_ha_namespace }}"
type: kubernetes.io/basic-auth
stringData:
  username: "{{ k3s_postgres_ha_source_superuser }}"
  password: "{{ k3s_postgres_ha_source_password }}"
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: "{{ k3s_postgres_ha_cluster_name }}"
  namespace: "{{ k3s_postgres_ha_namespace }}"
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/part-of: platform-bus
spec:
  instances: {{ k3s_postgres_ha_instances }}
  imageName: "{{ k3s_postgres_ha_image }}"
  primaryUpdateStrategy: unsupervised
  enableSuperuserAccess: true
  bootstrap:
    initdb:
      database: "{{ k3s_postgres_ha_source_superuser }}"
      owner: "{{ k3s_postgres_ha_source_superuser }}"
      secret:
        name: "{{ k3s_postgres_ha_cluster_name }}-bootstrap-owner"
      import:
        type: monolith
        databases:
          - "*"
        roles:
          - "*"
        source:
          externalCluster: platform-postgres-source
  externalClusters:
    - name: platform-postgres-source
      connectionParameters:
        host: "{{ k3s_postgres_ha_source_service }}"
        user: "{{ k3s_postgres_ha_source_superuser }}"
        dbname: postgres
        sslmode: disable
      password:
        name: "{{ k3s_postgres_ha_source_password_secret }}"
        key: "{{ k3s_postgres_ha_source_password_key }}"
  affinity:
    podAntiAffinityType: required
    topologyKey: kubernetes.io/hostname
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: "2"
      memory: 2Gi
  storage:
    storageClass: "{{ k3s_postgres_ha_storage_class }}"
    size: "{{ k3s_postgres_ha_storage_size }}"
  backup:
    target: prefer-standby
    volumeSnapshot:
      className: "{{ k3s_postgres_ha_snapshot_class }}"
      online: true
  monitoring:
    enablePodMonitor: true
---
apiVersion: postgresql.cnpg.io/v1
kind: Backup
metadata:
  name: "{{ k3s_postgres_ha_cluster_name }}-post-migration"
  namespace: "{{ k3s_postgres_ha_namespace }}"
spec:
  cluster:
    name: "{{ k3s_postgres_ha_cluster_name }}"
  method: volumeSnapshot
  target: prefer-standby
  online: true
---
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: "{{ k3s_postgres_ha_cluster_name }}-daily-snapshot"
  namespace: "{{ k3s_postgres_ha_namespace }}"
spec:
  schedule: "0 15 1 * * *"
  backupOwnerReference: cluster
  cluster:
    name: "{{ k3s_postgres_ha_cluster_name }}"
  method: volumeSnapshot
  target: prefer-standby
  online: true
